// For common_type deduction of Rep types (e.g. long long + int → long long).
// We use decltype(d1.count() + d2.count()) instead of std::common_type to keep
// things self-contained.

namespace std::chrono {

// Keep <filesystem> light; psychicstd duration bounds support builtin reps.
template <typename Rep> struct __duration_unsigned {
  using type = make_unsigned_t<Rep>;
};
template <> struct __duration_unsigned<__int128> {
  using type = unsigned __int128;
};
template <> struct __duration_unsigned<unsigned __int128> {
  using type = unsigned __int128;
};

template <typename Rep> constexpr Rep __duration_min() {
  if constexpr (is_same_v<Rep, float>)
    return -__FLT_MAX__;
  else if constexpr (is_same_v<Rep, double>)
    return -__DBL_MAX__;
  else if constexpr (is_same_v<Rep, long double>)
    return -__LDBL_MAX__;
  else if constexpr (is_same_v<Rep, bool> || is_unsigned_v<Rep> ||
                     is_same_v<Rep, unsigned __int128>)
    return Rep(0);
  else if constexpr (is_integral_v<Rep> || is_same_v<Rep, __int128>) {
    using U = typename __duration_unsigned<Rep>::type;
    constexpr U max = (U(1) << (sizeof(Rep) * __CHAR_BIT__ - 1)) - 1;
    return static_cast<Rep>(-static_cast<Rep>(max) - 1);
  } else
    return Rep();
}

template <typename Rep> constexpr Rep __duration_max() {
  if constexpr (is_same_v<Rep, float>)
    return __FLT_MAX__;
  else if constexpr (is_same_v<Rep, double>)
    return __DBL_MAX__;
  else if constexpr (is_same_v<Rep, long double>)
    return __LDBL_MAX__;
  else if constexpr (is_same_v<Rep, bool>)
    return true;
  else if constexpr (is_integral_v<Rep> || is_same_v<Rep, __int128> ||
                     is_same_v<Rep, unsigned __int128>) {
    using U = typename __duration_unsigned<Rep>::type;
    if constexpr (is_unsigned_v<Rep> || is_same_v<Rep, unsigned __int128>)
      return static_cast<Rep>(~U(0));
    else
      return static_cast<Rep>((U(1) << (sizeof(Rep) * __CHAR_BIT__ - 1)) - 1);
  } else
    return Rep();
}

template <typename Rep, typename Period = ratio<1>> class duration {
public:
  using rep = Rep;
  using period = Period;

  constexpr duration() = default;
  template <typename Rep2>
    requires(is_convertible_v<const Rep2&, Rep> &&
             (is_floating_point_v<Rep> || !is_floating_point_v<Rep2>))
  constexpr explicit duration(const Rep2& v) : rep_(static_cast<Rep>(v)) {}
  template <typename Rep2, typename Period2>
    requires((is_floating_point_v<Rep> ||
              ratio_divide<Period2, Period>::den == 1) &&
             (is_floating_point_v<Rep> || !is_floating_point_v<Rep2>))
  constexpr duration(const duration<Rep2, Period2>& d)
      : rep_(static_cast<Rep>(d.count()) * Period2::num * Period::den /
             (Period2::den * Period::num)) {}

  constexpr Rep count() const noexcept { return rep_; }
  constexpr duration operator+() const { return *this; }
  constexpr duration operator-() const { return duration(-rep_); }
  constexpr duration& operator+=(const duration& d) {
    rep_ += d.rep_;
    return *this;
  }
  constexpr duration& operator-=(const duration& d) {
    rep_ -= d.rep_;
    return *this;
  }
  constexpr duration& operator*=(Rep r) {
    rep_ *= r;
    return *this;
  }
  constexpr duration& operator/=(Rep r) {
    rep_ /= r;
    return *this;
  }
  constexpr duration& operator%=(Rep r) {
    rep_ %= r;
    return *this;
  }
  constexpr duration& operator%=(const duration& d) {
    rep_ %= d.rep_;
    return *this;
  }
  constexpr duration& operator++() {
    ++rep_;
    return *this;
  }
  constexpr duration operator++(int) { return duration(rep_++); }
  constexpr duration& operator--() {
    --rep_;
    return *this;
  }
  constexpr duration operator--(int) { return duration(rep_--); }

  static constexpr duration zero() { return duration(0); }
  static constexpr duration min() { return duration(__duration_min<Rep>()); }
  static constexpr duration max() { return duration(__duration_max<Rep>()); }

private:
  Rep rep_{};
};

// Cross-period arithmetic and comparison: convert both operands to the common
// duration (ratio_gcd period, wider rep) before comparing or combining.
template <typename R1, typename P1, typename R2, typename P2>
constexpr bool operator==(const duration<R1, P1>& a,
                          const duration<R2, P2>& b) {
  using CD =
      duration<decltype(declval<R1>() + declval<R2>()), ratio_gcd<P1, P2>>;
  return CD(a).count() == CD(b).count();
}
template <typename R1, typename P1, typename R2, typename P2>
constexpr bool operator<(const duration<R1, P1>& a, const duration<R2, P2>& b) {
  using CD =
      duration<decltype(declval<R1>() + declval<R2>()), ratio_gcd<P1, P2>>;
  return CD(a).count() < CD(b).count();
}
template <typename R1, typename P1, typename R2, typename P2>
constexpr bool operator!=(const duration<R1, P1>& a,
                          const duration<R2, P2>& b) {
  return !(a == b);
}
template <typename R1, typename P1, typename R2, typename P2>
constexpr bool operator<=(const duration<R1, P1>& a,
                          const duration<R2, P2>& b) {
  return !(b < a);
}
template <typename R1, typename P1, typename R2, typename P2>
constexpr bool operator>(const duration<R1, P1>& a, const duration<R2, P2>& b) {
  return b < a;
}
template <typename R1, typename P1, typename R2, typename P2>
constexpr bool operator>=(const duration<R1, P1>& a,
                          const duration<R2, P2>& b) {
  return !(a < b);
}

template <typename R1, typename P1, typename R2, typename P2>
constexpr auto operator+(const duration<R1, P1>& a, const duration<R2, P2>& b) {
  using CD =
      duration<decltype(declval<R1>() + declval<R2>()), ratio_gcd<P1, P2>>;
  return CD(CD(a).count() + CD(b).count());
}
template <typename R1, typename P1, typename R2, typename P2>
constexpr auto operator-(const duration<R1, P1>& a, const duration<R2, P2>& b) {
  using CD =
      duration<decltype(declval<R1>() - declval<R2>()), ratio_gcd<P1, P2>>;
  return CD(CD(a).count() - CD(b).count());
}
template <typename Rep, typename Period, typename Scalar>
  requires is_arithmetic_v<Scalar>
constexpr duration<Rep, Period> operator*(const duration<Rep, Period>& d,
                                          Scalar s) {
  return duration<Rep, Period>(static_cast<Rep>(d.count() * s));
}
template <typename Scalar, typename Rep, typename Period>
  requires is_arithmetic_v<Scalar>
constexpr duration<Rep, Period> operator*(Scalar s,
                                          const duration<Rep, Period>& d) {
  return d * s;
}
template <typename Rep, typename Period, typename Scalar>
  requires is_arithmetic_v<Scalar>
constexpr duration<Rep, Period> operator/(const duration<Rep, Period>& d,
                                          Scalar s) {
  return duration<Rep, Period>(static_cast<Rep>(d.count() / s));
}
template <typename R1, typename P1, typename R2, typename P2>
constexpr auto operator/(const duration<R1, P1>& a, const duration<R2, P2>& b) {
  using CD =
      duration<decltype(declval<R1>() / declval<R2>()), ratio_gcd<P1, P2>>;
  return CD(a).count() / CD(b).count();
}
template <typename Rep, typename Period, typename Scalar>
  requires is_integral_v<Rep> && is_integral_v<Scalar>
constexpr auto operator%(const duration<Rep, Period>& d, Scalar s) {
  using CommonRep = common_type_t<Rep, Scalar>;
  return duration<CommonRep, Period>(static_cast<CommonRep>(d.count()) %
                                     static_cast<CommonRep>(s));
}
template <typename R1, typename P1, typename R2, typename P2>
constexpr auto operator%(const duration<R1, P1>& a, const duration<R2, P2>& b) {
  using CD =
      duration<decltype(declval<R1>() % declval<R2>()), ratio_gcd<P1, P2>>;
  return CD(CD(a).count() % CD(b).count());
}

template <typename ToDur, typename Rep, typename Period>
constexpr ToDur duration_cast(const duration<Rep, Period>& d) {
  using ToRep = typename ToDur::rep;
  using ToPer = typename ToDur::period;
  using CalcRep =
      decltype(declval<Rep>() + declval<ToRep>() + declval<intmax_t>());
  // Cross-cancel before multiplying. Forming the unreduced products first
  // can itself overflow intmax_t even when the final ratio is representable.
  constexpr auto g1 = detail::gcd(Period::num < 0 ? -Period::num : Period::num,
                                  ToPer::num < 0 ? -ToPer::num : ToPer::num);
  constexpr auto g2 = detail::gcd(Period::den, ToPer::den);
  constexpr auto num = (Period::num / g1) * (ToPer::den / g2);
  constexpr auto den = (Period::den / g2) * (ToPer::num / g1);

  if constexpr (num == 1 && den != 1) {
    // this is likely the most common case - typical example is going from ns to
    // ms
    return ToDur(static_cast<ToRep>(static_cast<CalcRep>(d.count()) /
                                    static_cast<CalcRep>(den)));
  } else if constexpr (num != 1 && den != 1) {
    // converting between different bases, like "1/24:th seconds" and
    // microseconds
    return ToDur(static_cast<ToRep>(static_cast<CalcRep>(d.count()) *
                                    static_cast<CalcRep>(num) /
                                    static_cast<CalcRep>(den)));
  } else if constexpr (num != 1) {
    return ToDur(static_cast<ToRep>(static_cast<CalcRep>(d.count()) *
                                    static_cast<CalcRep>(num)));
  } else {
    return ToDur(static_cast<ToRep>(d.count()));
  }
}

using nanoseconds = duration<long long, nano>;
using microseconds = duration<long long, micro>;
using milliseconds = duration<long long, milli>;
using seconds = duration<long long>;
using minutes = duration<int, ratio<60>>;
using hours = duration<int, ratio<3600>>;
using days = duration<int, ratio<86400>>;

template <typename Clock, typename Duration = typename Clock::duration>
class time_point {
public:
  using clock = Clock;
  using duration = Duration;
  using rep = typename Duration::rep;
  using period = typename Duration::period;

  constexpr time_point() = default;
  constexpr explicit time_point(const Duration& d) : d_(d) {}
  template <typename Duration2>
  constexpr time_point(const time_point<Clock, Duration2>& t)
      : d_(t.time_since_epoch()) {}

  constexpr Duration time_since_epoch() const { return d_; }

  constexpr time_point& operator+=(const Duration& d) {
    d_ += d;
    return *this;
  }
  constexpr time_point& operator-=(const Duration& d) {
    d_ -= d;
    return *this;
  }

  static constexpr time_point min() { return time_point(Duration::min()); }
  static constexpr time_point max() { return time_point(Duration::max()); }

private:
  Duration d_{};
};

template <typename C, typename D1, typename D2>
constexpr auto operator-(const time_point<C, D1>& a,
                         const time_point<C, D2>& b) {
  return a.time_since_epoch() - b.time_since_epoch();
}
template <typename C, typename D, typename R, typename P>
constexpr auto operator+(const time_point<C, D>& tp, const duration<R, P>& d) {
  using result_duration = decltype(tp.time_since_epoch() + d);
  return time_point<C, result_duration>(tp.time_since_epoch() + d);
}
template <typename C, typename D, typename R, typename P>
constexpr auto operator-(const time_point<C, D>& tp, const duration<R, P>& d) {
  using result_duration = decltype(tp.time_since_epoch() - d);
  return time_point<C, result_duration>(tp.time_since_epoch() - d);
}

template <typename ToDur, typename Clock, typename Dur>
constexpr time_point<Clock, ToDur>
time_point_cast(const time_point<Clock, Dur>& tp) {
  return time_point<Clock, ToDur>(duration_cast<ToDur>(tp.time_since_epoch()));
}

template <typename C, typename D1, typename D2>
constexpr bool operator==(const time_point<C, D1>& a,
                          const time_point<C, D2>& b) {
  return a.time_since_epoch() == b.time_since_epoch();
}
template <typename C, typename D1, typename D2>
constexpr bool operator<(const time_point<C, D1>& a,
                         const time_point<C, D2>& b) {
  return a.time_since_epoch() < b.time_since_epoch();
}
template <typename C, typename D1, typename D2>
constexpr bool operator!=(const time_point<C, D1>& a,
                          const time_point<C, D2>& b) {
  return !(a == b);
}
template <typename C, typename D1, typename D2>
constexpr bool operator>(const time_point<C, D1>& a,
                         const time_point<C, D2>& b) {
  return b < a;
}
template <typename C, typename D1, typename D2>
constexpr bool operator<=(const time_point<C, D1>& a,
                          const time_point<C, D2>& b) {
  return !(b < a);
}
template <typename C, typename D1, typename D2>
constexpr bool operator>=(const time_point<C, D1>& a,
                          const time_point<C, D2>& b) {
  return !(a < b);
}

struct system_clock;
struct file_clock;

template <typename Duration>
using sys_time = time_point<system_clock, Duration>;
template <typename Duration> using file_time = time_point<file_clock, Duration>;

struct file_clock {
  using duration = nanoseconds;
  using rep = duration::rep;
  using period = duration::period;
  using time_point = chrono::time_point<file_clock>;
  static constexpr bool is_steady = false;

  template <typename Duration>
  static sys_time<Duration> to_sys(const file_time<Duration>& value) noexcept {
    return sys_time<Duration>(value.time_since_epoch());
  }

  template <typename Duration>
  static file_time<Duration>
  from_sys(const sys_time<Duration>& value) noexcept {
    return file_time<Duration>(value.time_since_epoch());
  }
};

}
