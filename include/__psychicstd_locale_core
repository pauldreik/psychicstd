#pragma once
#include <__psychicstd_config>

namespace std {

// A small, process-local locale implementation. Runtime ownership stays out of
// line so stream headers only parse the interfaces needed by ios_base.
class locale {
public:
  using category = int;
  static constexpr category none = 0;
  static constexpr category collate = 1 << 0;
  static constexpr category ctype = 1 << 1;
  static constexpr category monetary = 1 << 2;
  static constexpr category numeric = 1 << 3;
  static constexpr category time = 1 << 4;
  static constexpr category messages = 1 << 5;
  static constexpr category all =
      collate | ctype | monetary | numeric | time | messages;

  class facet {
  public:
    virtual ~facet() = default;
    facet(const facet&) = delete;
    facet& operator=(const facet&) = delete;

  protected:
    facet() = default;
  };
  class id {};

  locale() noexcept;
  explicit locale(const char* name);
  locale(const locale& o) noexcept;
  locale& operator=(const locale& o) noexcept;
  ~locale();

  // Install f into a copy of other. Inherited facets remain shared.
  template <typename Facet>
  locale(const locale& other, Facet* f) : rep_(_with_facet(other.rep_, f)) {}

  static const locale& classic();
  static locale global(const locale& loc);

  bool operator==(const locale& o) const noexcept;
  bool operator!=(const locale& o) const noexcept;
  bool _has_facets() const noexcept;

  template <typename F> const F* _facet() const {
#if _PSYCHICSTD_HAS_RTTI
    for (_node* node = _first_facet(rep_); node; node = _next_facet(node))
      if (const auto* facet = dynamic_cast<const F*>(_facet_value(node)))
        return facet;
#else
    (void)sizeof(F);
#endif
    return nullptr;
  }

private:
  struct _node;
  struct _rep;
  _rep* rep_ = nullptr;
  static _rep* _make_named(const char* name);
  static _rep* _with_facet(_rep* other, facet* f);
  static _node* _first_facet(_rep* rep) noexcept;
  static _node* _next_facet(_node* node) noexcept;
  static facet* _facet_value(_node* node) noexcept;
  void _release() noexcept;
  static locale& _global();
  friend void swap(locale&, locale&) noexcept;
};

void swap(locale&, locale&) noexcept;

} // namespace std
