#pragma once
#include <cstdint>
#include <string>
#include <string_view>
#include <system_error>

namespace std {
namespace filesystem {

class path {
  using __str = std::string;
  using __u8str = std::u8string;

public:
  path() = default;
  path(const char* s) : path_(s) {}
  path(const __str& s) : path_(s) {}
  // move
  path(__str&& s) : path_(static_cast<__str&&>(s)) {}
  path(string_view s) : path_(s.data(), s.size()) {}
  path(u8string_view s)
      : path_(reinterpret_cast<const char*>(s.data()), s.size()) {}

  path& operator=(const char* s) {
    path_ = s;
    return *this;
  }
  path& operator=(const __str& s) {
    path_ = s;
    return *this;
  }

  bool empty() const noexcept { return path_.empty(); }
  const __str& string() const noexcept { return path_; }
  operator __str() const { return path_; }
  __u8str u8string() const {
    return __u8str(reinterpret_cast<const char8_t*>(path_.data()),
                   path_.size());
  }
  const char* c_str() const noexcept { return path_.c_str(); }

  path filename() const {
    auto pos = path_.find_last_of('/');
    return pos == __str::npos ? path_ : path_.substr(pos + 1);
  }

  path stem() const {
    path name = filename();
    auto pos = name.path_.find_last_of('.');
    if (pos == __str::npos || pos == 0)
      return name;
    return name.path_.substr(0, pos);
  }

  path extension() const {
    path name = filename();
    auto pos = name.path_.find_last_of('.');
    if (pos == __str::npos || pos == 0)
      return path();
    return name.path_.substr(pos);
  }

  path parent_path() const {
    auto pos = path_.find_last_of('/');
    return pos == __str::npos ? path() : path(path_.substr(0, pos));
  }

  path lexically_relative(const path& base) const;
  path& replace_extension(const path& replacement = path());

  path& operator/=(const path& p) {
    if (!p.empty()) {
      if (!path_.empty() && path_.back() != '/')
        path_ += '/';
      path_ += p.path_;
    }
    return *this;
  }

  friend path operator/(path lhs, const path& rhs) {
    lhs /= rhs;
    return lhs;
  }

  friend bool operator==(const path& a, const path& b) noexcept {
    return a.path_ == b.path_;
  }

  template <typename Char, typename Traits>
  friend basic_ostream<Char, Traits>&
  operator<<(basic_ostream<Char, Traits>& output, const path& value) {
    return output << '"' << value.string() << '"';
  }

private:
  __str path_;
};

enum class directory_options : unsigned char {
  none = 0,
  follow_directory_symlink = 1,
  skip_permission_denied = 2,
};

constexpr directory_options operator|(directory_options lhs,
                                      directory_options rhs) noexcept {
  return static_cast<directory_options>(static_cast<unsigned char>(lhs) |
                                        static_cast<unsigned char>(rhs));
}

class directory_entry {
public:
  directory_entry() = default;
  explicit directory_entry(filesystem::path p)
      : path_(static_cast<filesystem::path&&>(p)) {}

  const filesystem::path& path() const noexcept { return path_; }

private:
  filesystem::path path_;
};

class recursive_directory_iterator {
  struct _state;

public:
  recursive_directory_iterator() noexcept = default;
  explicit recursive_directory_iterator(
      const path&, directory_options = directory_options::none);
  recursive_directory_iterator(const recursive_directory_iterator&) noexcept;
  recursive_directory_iterator(recursive_directory_iterator&& other) noexcept;
  recursive_directory_iterator&
  operator=(const recursive_directory_iterator&) noexcept;
  recursive_directory_iterator&
  operator=(recursive_directory_iterator&& other) noexcept;
  ~recursive_directory_iterator();

  const directory_entry& operator*() const noexcept;
  const directory_entry* operator->() const noexcept;
  recursive_directory_iterator& operator++();

  friend bool operator==(const recursive_directory_iterator& lhs,
                         const recursive_directory_iterator& rhs) noexcept {
    return lhs.state_ == rhs.state_;
  }

private:
  void release() noexcept;
  _state* state_ = nullptr;
};

inline recursive_directory_iterator
begin(recursive_directory_iterator iter) noexcept {
  return iter;
}

inline recursive_directory_iterator
end(const recursive_directory_iterator&) noexcept {
  return {};
}

class filesystem_error : public system_error {
  path path1_;

public:
  filesystem_error(const string& what_arg, error_code ec)
      : system_error(ec, what_arg) {}
  filesystem_error(const string& what_arg, const path& p1, error_code ec)
      : system_error(ec, what_arg), path1_(p1) {}
  const path& path1() const noexcept { return path1_; }
};

bool exists(const path&) noexcept;
bool is_directory(const path&) noexcept;
bool is_regular_file(const path&) noexcept;
uintmax_t file_size(const path&);

} // namespace filesystem
} // namespace std
