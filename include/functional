namespace detail {
template <typename F, typename... Bound> struct __bind_wrapper;

// Wrap a value — if it's a placeholder, substitute; otherwise pass through.
template <typename T, typename... Rest>
constexpr decltype(auto) __bind_arg(T&& v, Rest&&...) {
  return static_cast<T&&>(v);
}
// Nested bind: invoke the nested bind expression with the call args
template <typename F, typename... Bound, typename... Args>
constexpr decltype(auto) __bind_arg(__bind_wrapper<F, Bound...>& bw,
                                    Args&&... args) {
  return bw(static_cast<Args&&>(args)...);
}
template <typename F, typename... Bound, typename... Args>
constexpr decltype(auto) __bind_arg(const __bind_wrapper<F, Bound...>& bw,
                                    Args&&... args) {
  return bw(static_cast<Args&&>(args)...);
}
template <typename T, typename... Rest>
constexpr T& __bind_arg(reference_wrapper<T> ref, Rest&&...) {
  return ref.get();
}
template <typename A0, typename... Rest>
constexpr A0&& __bind_arg(placeholders::__placeholder<0>, A0&& a0, Rest&&...) {
  return static_cast<A0&&>(a0);
}
