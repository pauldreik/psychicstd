namespace std {

struct identity {
  using is_transparent = void;

  template <typename T> constexpr T&& operator()(T&& value) const noexcept {
    return static_cast<T&&>(value);
  }
};

// function<R(Args...)> — type-erased callable
template <typename> class function;

template <typename R, typename... Args> class function<R(Args...)> {
  // Type ID by address.
  template <typename T> static inline constexpr char target_token_ = 0;

  struct base {
    virtual R call(Args...) = 0;
    virtual base* clone() = 0;
    virtual void* target(const void* id) noexcept = 0;
    virtual ~base() = default;
  };
  template <typename F> struct impl : base {
    F f_;
    impl(F f) : f_(static_cast<F&&>(f)) {}
    R call(Args... args) override {
      return detail::__invoke(f_, static_cast<Args&&>(args)...);
    }
    base* clone() override { return new impl(f_); }
    void* target(const void* id) noexcept override {
      return id == &target_token_<F> ? &f_ : nullptr;
    }
  };

  template <typename F> static base* make_target(F&& f) {
    using target_type = decay_t<F>;
    if constexpr (is_pointer_v<target_type> ||
                  is_member_pointer_v<target_type>) {
      if (f == nullptr)
        return nullptr;
    }
    return new impl<target_type>(static_cast<F&&>(f));
  }

  base* ptr_ = nullptr;

public:
  function() noexcept = default;
  function(nullptr_t) noexcept {}
  function(const function& o) : ptr_(o.ptr_ ? o.ptr_->clone() : nullptr) {}
  function(function&& o) noexcept : ptr_(o.ptr_) { o.ptr_ = nullptr; }
  template <typename F>
    requires(!is_same_v<decay_t<F>, function> &&
             is_invocable_r_v<R, decay_t<F>&, Args...>)
  function(F&& f) : ptr_(make_target(static_cast<F&&>(f))) {}
  ~function() { delete ptr_; }

  function& operator=(const function& o) {
    if (this != &o) {
      delete ptr_;
      ptr_ = o.ptr_ ? o.ptr_->clone() : nullptr;
    }
    return *this;
  }
  function& operator=(function&& o) noexcept {
    delete ptr_;
    ptr_ = o.ptr_;
    o.ptr_ = nullptr;
    return *this;
  }
  function& operator=(nullptr_t) noexcept {
    delete ptr_;
    ptr_ = nullptr;
    return *this;
  }
  template <typename F>
    requires(!is_same_v<decay_t<F>, function> &&
             is_invocable_r_v<R, decay_t<F>&, Args...>)
  function& operator=(F&& f) {
    function(static_cast<F&&>(f)).swap(*this);
    return *this;
  }

  explicit operator bool() const noexcept { return ptr_ != nullptr; }

  void swap(function& other) noexcept {
    base* value = ptr_;
    ptr_ = other.ptr_;
    other.ptr_ = value;
  }

  R operator()(Args... args) const {
    return ptr_->call(static_cast<Args&&>(args)...);
  }

  template <typename T> T* target() noexcept {
    return ptr_ ? static_cast<T*>(ptr_->target(&target_token_<T>)) : nullptr;
  }
  template <typename T> const T* target() const noexcept {
    return ptr_ ? static_cast<const T*>(ptr_->target(&target_token_<T>))
                : nullptr;
  }

  friend bool operator==(const function& f, nullptr_t) noexcept {
    return f.ptr_ == nullptr;
  }
  friend bool operator==(nullptr_t, const function& f) noexcept {
    return f.ptr_ == nullptr;
  }
};

