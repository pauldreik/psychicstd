template <typename F, typename... Bound> struct __bind_wrapper {
  F f_;
  tuple<Bound...> bound_;
  template <typename F2, typename... B2>
    requires(!is_same_v<decay_t<F2>, __bind_wrapper>)
  constexpr __bind_wrapper(F2&& f, B2&&... b)
      : f_(static_cast<F2&&>(f)), bound_(static_cast<B2&&>(b)...) {}
  template <typename... Args>
  constexpr decltype(auto) operator()(Args&&... args) {
    return __call(index_sequence_for<Bound...>{}, static_cast<Args&&>(args)...);
  }
  template <typename... Args>
  constexpr decltype(auto) operator()(Args&&... args) const {
    return __call(index_sequence_for<Bound...>{}, static_cast<Args&&>(args)...);
  }

private:
  template <size_t... Is, typename... Args>
  constexpr decltype(auto) __call(index_sequence<Is...>, Args&&... args) {
    auto resolved = tuple<decltype(detail::__bind_arg(
        get<Is>(bound_), static_cast<Args&&>(args)...))...>(
        detail::__bind_arg(get<Is>(bound_), static_cast<Args&&>(args)...)...);
    return apply(
        [this](auto&&... resolved_args) -> decltype(auto) {
          return detail::__invoke(
              f_, static_cast<decltype(resolved_args)>(resolved_args)...);
        },
        static_cast<decltype(resolved)&&>(resolved));
  }
  template <size_t... Is, typename... Args>
  constexpr decltype(auto) __call(index_sequence<Is...>, Args&&... args) const {
    auto resolved = tuple<decltype(detail::__bind_arg(
        get<Is>(bound_), static_cast<Args&&>(args)...))...>(
        detail::__bind_arg(get<Is>(bound_), static_cast<Args&&>(args)...)...);
    return apply(
        [this](auto&&... resolved_args) -> decltype(auto) {
          return detail::__invoke(
              f_, static_cast<decltype(resolved_args)>(resolved_args)...);
        },
        static_cast<decltype(resolved)&&>(resolved));
  }
};
} // namespace detail

template <typename F, typename... Args>
constexpr decltype(auto) invoke(F&& f, Args&&... args) {
  return detail::__invoke(static_cast<F&&>(f), static_cast<Args&&>(args)...);
}

template <typename F, typename... Args>
constexpr auto bind(F&& f, Args&&... args) {
  return detail::__bind_wrapper<decay_t<F>, decay_t<Args>...>(
      static_cast<F&&>(f), static_cast<Args&&>(args)...);
}

// std::mem_fn — creates a call wrapper for a member pointer
template <typename R, typename T> constexpr auto mem_fn(R T::* pm) {
  return [pm](auto&&... args) -> decltype(auto) {
    return detail::__invoke(pm, static_cast<decltype(args)>(args)...);
  };
}

} // namespace std
