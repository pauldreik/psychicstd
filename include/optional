namespace std {

struct nullopt_t {
  struct __secret {};
  explicit constexpr nullopt_t(__secret) noexcept {}
};
inline constexpr nullopt_t nullopt{nullopt_t::__secret{}};

class bad_optional_access : public exception {
public:
  bad_optional_access() noexcept = default;
  const char* what() const noexcept override { return "bad optional access"; }
};

[[noreturn, gnu::cold, gnu::noinline]] void __throw_bad_optional_access();

template <typename T> class optional;
template <typename T> struct __is_optional : false_type {};
template <typename T> struct __is_optional<optional<T>> : true_type {};

template <typename T>
constexpr void __optional_swap(T& a, T& b) noexcept(is_nothrow_swappable_v<T>) {
  using std::swap;
  swap(a, b);
}

template <typename T> class optional {
  union {
    T val_;
    char _dummy;
  };
  bool has_;

  constexpr T* ptr() noexcept { return addressof(val_); }
  constexpr const T* ptr() const noexcept { return addressof(val_); }

public:
  using value_type = T;

  constexpr optional() noexcept : _dummy(0), has_(false) {}
  constexpr optional(nullopt_t) noexcept : _dummy(0), has_(false) {}

  constexpr optional(const optional& o) : _dummy(0), has_(false) {
    if (o.has_) {
      construct_at(ptr(), *o.ptr());
      has_ = true;
    }
  }
  constexpr optional(optional&& o) noexcept(is_nothrow_move_constructible_v<T>)
      : _dummy(0), has_(false) {
    if (o.has_) {
      construct_at(ptr(), static_cast<T&&>(*o.ptr()));
      has_ = true;
    }
  }
  constexpr optional(const T& value) : val_(value), has_(true) {}
  constexpr optional(T&& value) : val_(static_cast<T&&>(value)), has_(true) {}
  template <typename U = T>
    requires(!is_same_v<remove_cvref_t<U>, optional> &&
             !__is_optional<remove_cvref_t<U>>::value &&
             !is_same_v<remove_cvref_t<U>, T>)
  // forward
  constexpr optional(U&& v) : val_(static_cast<U&&>(v)), has_(true) {}
  template <typename U>
    requires(is_constructible_v<T, const U&>)
  constexpr explicit(!is_convertible_v<const U&, T>)
      optional(const optional<U>& other)
      : _dummy(0), has_(false) {
    if (other) {
      construct_at(ptr(), *other);
      has_ = true;
    }
  }
  template <typename U>
    requires(is_constructible_v<T, U &&>)
  constexpr explicit(!is_convertible_v<U&&, T>) optional(optional<U>&& other)
      : _dummy(0), has_(false) {
    if (other) {
      construct_at(ptr(), static_cast<U&&>(*other));
      has_ = true;
    }
  }
  template <typename... Args>
  constexpr explicit optional(in_place_t, Args&&... args)
      : val_(static_cast<Args&&>(args)...), has_(true) {}
  template <typename U, typename... Args>
  constexpr explicit optional(in_place_t, initializer_list<U> values,
                              Args&&... args)
      : val_(values, static_cast<Args&&>(args)...), has_(true) {}

  constexpr ~optional() { reset(); }

  constexpr optional& operator=(nullopt_t) noexcept {
    reset();
    return *this;
  }
  constexpr optional& operator=(const optional& o) {
    if (&o == this)
      return *this;
    if (has_ && o.has_) {
      val_ = *o.ptr();
    } else if (o.has_) {
      construct_at(ptr(), *o.ptr());
      has_ = true;
    } else {
      reset();
    }
    return *this;
  }
  constexpr optional&
  operator=(optional&& o) noexcept(is_nothrow_move_assignable_v<T> &&
                                   is_nothrow_move_constructible_v<T>) {
    if (&o == this)
      return *this;
    if (has_ && o.has_) {
      val_ = static_cast<T&&>(*o.ptr());
    } else if (o.has_) {
      construct_at(ptr(), static_cast<T&&>(*o.ptr()));
      has_ = true;
    } else {
      reset();
    }
    return *this;
  }
  template <typename U = T>
    requires(!is_same_v<remove_cvref_t<U>, optional>)
  constexpr optional& operator=(U&& value) {
    if (has_)
      val_ = static_cast<U&&>(value);
    else {
      construct_at(ptr(), static_cast<U&&>(value));
      has_ = true;
    }
    return *this;
  }

  constexpr explicit operator bool() const noexcept { return has_; }
  constexpr bool has_value() const noexcept { return has_; }

  constexpr T& value() & {
    if (!has_)
      _PSYCHICSTD_THROW_HELPER(__throw_bad_optional_access);
    return val_;
  }
  constexpr const T& value() const& {
    if (!has_)
      _PSYCHICSTD_THROW_HELPER(__throw_bad_optional_access);
    return val_;
  }
  constexpr T&& value() && {
    if (!has_)
      _PSYCHICSTD_THROW_HELPER(__throw_bad_optional_access);
    return static_cast<T&&>(val_);
  }
  constexpr const T&& value() const&& {
    if (!has_)
      _PSYCHICSTD_THROW_HELPER(__throw_bad_optional_access);
    return static_cast<const T&&>(val_);
  }
  constexpr T& operator*() & noexcept { return val_; }
  constexpr const T& operator*() const& noexcept { return val_; }
  constexpr T&& operator*() && noexcept { return static_cast<T&&>(val_); }
  constexpr const T&& operator*() const&& noexcept {
    return static_cast<const T&&>(val_);
  }
  constexpr T* operator->() noexcept { return ptr(); }
  constexpr const T* operator->() const noexcept { return ptr(); }

  template <typename U> constexpr T value_or(U&& u) const& {
    // forward
    return has_ ? val_ : static_cast<T>(static_cast<U&&>(u));
  }
  template <typename U> constexpr T value_or(U&& u) && {
    return has_ ? static_cast<T&&>(val_) : static_cast<T>(static_cast<U&&>(u));
  }

  constexpr void reset() noexcept {
    if (has_) {
      destroy_at(ptr());
      has_ = false;
    }
  }

  constexpr void
  swap(optional& other) noexcept(is_nothrow_move_constructible_v<T> &&
                                 is_nothrow_swappable_v<T>)
    requires(is_move_constructible_v<T> && is_swappable_v<T>)
  {
    if (has_ && other.has_) {
      __optional_swap(val_, other.val_);
    } else if (has_) {
      construct_at(other.ptr(), static_cast<T&&>(val_));
      other.has_ = true;
      reset();
    } else if (other.has_) {
      construct_at(ptr(), static_cast<T&&>(other.val_));
      has_ = true;
      other.reset();
    }
  }

  template <typename... Args> constexpr T& emplace(Args&&... args) {
    reset();
    // forward
    construct_at(ptr(), static_cast<Args&&>(args)...);
    has_ = true;
    return val_;
  }
  template <typename U> constexpr T& emplace(initializer_list<U> values) {
    reset();
    construct_at(ptr(), values);
    has_ = true;
    return val_;
  }
};

template <typename T>
  requires(is_move_constructible_v<T> && is_swappable_v<T>)
constexpr void swap(optional<T>& a,
                    optional<T>& b) noexcept(noexcept(a.swap(b))) {
  a.swap(b);
}

template <typename T, typename U>
constexpr bool operator==(const optional<T>& a, const optional<U>& b) {
  if (a.has_value() != b.has_value())
    return false;
  return !a.has_value() || *a == *b;
}
template <typename T, typename U>
constexpr bool operator!=(const optional<T>& a, const optional<U>& b) {
  if (a.has_value() != b.has_value())
    return true;
  return a.has_value() && *a != *b;
}
template <typename T, typename U>
constexpr bool operator<(const optional<T>& a, const optional<U>& b) {
  return b.has_value() && (!a.has_value() || *a < *b);
}
template <typename T, typename U>
constexpr bool operator>(const optional<T>& a, const optional<U>& b) {
  return a.has_value() && (!b.has_value() || *a > *b);
}
template <typename T, typename U>
constexpr bool operator<=(const optional<T>& a, const optional<U>& b) {
  return !a.has_value() || (b.has_value() && *a <= *b);
}
template <typename T, typename U>
constexpr bool operator>=(const optional<T>& a, const optional<U>& b) {
  return !b.has_value() || (a.has_value() && *a >= *b);
}
template <typename T, typename U>
  requires three_way_comparable_with<T, U>
constexpr compare_three_way_result_t<T, U> operator<=>(const optional<T>& a,
                                                       const optional<U>& b) {
  if (a && b)
    return *a <=> *b;
  return a.has_value() <=> b.has_value();
}

template <typename T>
constexpr bool operator==(const optional<T>& a, nullopt_t) noexcept {
  return !a.has_value();
}
template <typename T>
constexpr strong_ordering operator<=>(const optional<T>& a,
                                      nullopt_t) noexcept {
  return a.has_value() <=> false;
}

// Mixed comparisons: optional<T> vs a non-optional value.
template <typename U>
concept __non_optional = !__is_optional<remove_cvref_t<U>>::value;
// Keep invalid mixed comparisons out of overload resolution. C++20 specifies
// these expressions as mandates, but constraints give generic code a safe no.
template <typename T, typename U>
concept __optional_equality_comparable =
    requires(const T& a, const U& b) { a == b; };
template <typename T, typename U>
concept __optional_less_than_comparable =
    requires(const T& a, const U& b) { a < b; };
template <typename T, typename U>
concept __optional_greater_than_comparable =
    requires(const T& a, const U& b) { a > b; };
template <typename T, typename U>
concept __optional_less_equal_comparable =
    requires(const T& a, const U& b) { a <= b; };
template <typename T, typename U>
concept __optional_greater_equal_comparable =
    requires(const T& a, const U& b) { a >= b; };

template <typename T, typename U>
  requires __non_optional<U> && __optional_equality_comparable<T, U>
constexpr bool operator==(const optional<T>& a, const U& b) {
  return a.has_value() && *a == b;
}
template <typename T, typename U>
  requires __non_optional<U> && __optional_equality_comparable<U, T>
constexpr bool operator==(const U& a, const optional<T>& b) {
  return b.has_value() && a == *b;
}
template <typename T, typename U>
  requires __non_optional<U> && __optional_equality_comparable<T, U>
constexpr bool operator!=(const optional<T>& a, const U& b) {
  return !a.has_value() || *a != b;
}
template <typename T, typename U>
  requires __non_optional<U> && __optional_equality_comparable<U, T>
constexpr bool operator!=(const U& a, const optional<T>& b) {
  return !b.has_value() || a != *b;
}
template <typename T, typename U>
  requires __non_optional<U> && __optional_less_than_comparable<T, U>
constexpr bool operator<(const optional<T>& a, const U& b) {
  return !a.has_value() || *a < b;
}
template <typename T, typename U>
  requires __non_optional<U> && __optional_less_than_comparable<U, T>
constexpr bool operator<(const U& a, const optional<T>& b) {
  return b.has_value() && a < *b;
}
template <typename T, typename U>
  requires __non_optional<U> && __optional_greater_than_comparable<T, U>
constexpr bool operator>(const optional<T>& a, const U& b) {
  return a.has_value() && *a > b;
}
template <typename T, typename U>
  requires __non_optional<U> && __optional_greater_than_comparable<U, T>
constexpr bool operator>(const U& a, const optional<T>& b) {
  return !b.has_value() || a > *b;
}
template <typename T, typename U>
  requires __non_optional<U> && __optional_less_equal_comparable<T, U>
constexpr bool operator<=(const optional<T>& a, const U& b) {
  return !a.has_value() || *a <= b;
}
template <typename T, typename U>
  requires __non_optional<U> && __optional_less_equal_comparable<U, T>
constexpr bool operator<=(const U& a, const optional<T>& b) {
  return b.has_value() && a <= *b;
}
template <typename T, typename U>
  requires __non_optional<U> && __optional_greater_equal_comparable<T, U>
constexpr bool operator>=(const optional<T>& a, const U& b) {
  return a.has_value() && *a >= b;
}
template <typename T, typename U>
  requires __non_optional<U> && __optional_greater_equal_comparable<U, T>
constexpr bool operator>=(const U& a, const optional<T>& b) {
  return !b.has_value() || a >= *b;
}
template <typename T, typename U>
  requires __non_optional<U> && three_way_comparable_with<T, U>
constexpr compare_three_way_result_t<T, U> operator<=>(const optional<T>& a,
                                                       const U& b) {
  return a ? *a <=> b : strong_ordering::less;
}

template <typename T> constexpr optional<decay_t<T>> make_optional(T&& v) {
  // forward
  return optional<decay_t<T>>(static_cast<T&&>(v));
}
template <typename T, typename... Args>
constexpr optional<T> make_optional(Args&&... args) {
  return optional<T>(in_place, static_cast<Args&&>(args)...);
}

