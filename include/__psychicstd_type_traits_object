// GCC 16 and Clang provide precise destructibility builtins. Older GCC only
// provides __has_trivial_destructor, which also reports true for deleted
// destructors, so combine it with the expression-based check below.
template <typename T> struct is_destructible;
#if defined(__clang__) && __has_builtin(__is_trivially_destructible)
template <typename T>
struct is_trivially_destructible
    : bool_constant<__is_trivially_destructible(T)> {};
#elif defined(__GNUC__) && !defined(__clang__) && __GNUC__ >= 16
template <typename T>
struct is_trivially_destructible
    : bool_constant<__is_trivially_destructible(T)> {};
#else
template <typename T>
struct is_trivially_destructible
    : bool_constant<__has_trivial_destructor(T) && is_destructible<T>::value> {
};
#endif
template <typename T>
inline constexpr bool is_trivially_destructible_v =
    is_trivially_destructible<T>::value;

