namespace std {

bool __ostream_sentry_should_flush() noexcept;

template <typename T, typename D> class unique_ptr;

template <typename Char, typename Traits>
class basic_ostream : public virtual basic_ios<Char, Traits> {
public:
  using char_type = Char;
  using traits_type = Traits;
  using int_type = typename Traits::int_type;
  using pos_type = typename Traits::pos_type;
  using off_type = typename Traits::off_type;

  explicit basic_ostream(basic_streambuf<Char, Traits>* sb) { this->init(sb); }

  virtual ~basic_ostream() = default;
  basic_ostream(const basic_ostream&) = delete;
  basic_ostream& operator=(const basic_ostream&) = delete;
  basic_ostream(basic_ostream&& other) noexcept : basic_ios<Char, Traits>() {
    this->init(other.rdbuf());
    this->copyfmt(other);
  }
  basic_ostream& operator=(basic_ostream&& other) noexcept {
    if (this != &other) {
      this->rdbuf(other.rdbuf());
      this->copyfmt(other);
    }
    return *this;
  }

  class sentry {
  public:
    explicit sentry(basic_ostream& os) : os_(os), ok_(os.good()) {
      if (ok_) {
        if (auto* tied = os.tie())
          tied->flush();
        ok_ = os.good();
      }
    }
    ~sentry() {
      if ((os_.flags() & ios_base::unitbuf) &&
          __ostream_sentry_should_flush()) {
        auto* sb = os_.rdbuf();
        if (sb && sb->pubsync() == -1)
          os_.setstate(ios_base::badbit);
      }
    }
    explicit operator bool() const noexcept { return ok_; }

  private:
    basic_ostream& os_;
    bool ok_;
  };

  basic_ostream& write(const Char* s, streamsize n) {
    auto* sb = this->rdbuf();
    if (!sb || sb->sputn(s, n) != n)
      this->setstate(ios_base::badbit);
    flush_if_unitbuf();
    return *this;
  }
  basic_ostream& put(Char c) {
    write(&c, 1);
    return *this;
  }
  Char widen(char c) const { return static_cast<Char>(c); }
  basic_ostream& flush() {
    if (this->rdbuf() && this->rdbuf()->pubsync() == -1)
      this->setstate(ios_base::badbit);
    return *this;
  }
  pos_type tellp() {
    return this->rdbuf()
               ? this->rdbuf()->pubseekoff(0, ios_base::cur, ios_base::out)
               : pos_type(off_type(-1));
  }
  basic_ostream& seekp(pos_type pos) {
    if (!this->rdbuf() ||
        this->rdbuf()->pubseekpos(pos, ios_base::out) == pos_type(off_type(-1)))
      this->setstate(ios_base::failbit);
    return *this;
  }
  basic_ostream& seekp(off_type off, ios_base::seekdir dir) {
    if (!this->rdbuf() || this->rdbuf()->pubseekoff(off, dir, ios_base::out) ==
                              pos_type(off_type(-1)))
      this->setstate(ios_base::failbit);
    return *this;
  }

  // Manipulators
  basic_ostream& operator<<(basic_ostream& (*pf)(basic_ostream&)) {
    return pf(*this);
  }
  basic_ostream& operator<<(ios_base& (*pf)(ios_base&)) {
    pf(*this);
    return *this;
  }
  basic_ostream&
  operator<<(basic_ios<Char, Traits>& (*pf)(basic_ios<Char, Traits>&)) {
    pf(*this);
    return *this;
  }

  // Arithmetic types
  basic_ostream& operator<<(bool v) {
    if (this->flags_ & ios_base::boolalpha)
      return write_padded(v ? "true" : "false");
    char buf[2] = {(char)('0' + v), '\0'};
    return write_padded(buf);
  }
  basic_ostream& operator<<(short v) { return write_int(v); }
  basic_ostream& operator<<(int v) { return write_int(v); }
  basic_ostream& operator<<(long v) { return write_int(v); }
  basic_ostream& operator<<(long long v) { return write_int(v); }
  basic_ostream& operator<<(unsigned short v) { return write_uint(v); }
  basic_ostream& operator<<(unsigned int v) { return write_uint(v); }
  basic_ostream& operator<<(unsigned long v) { return write_uint(v); }
  basic_ostream& operator<<(unsigned long long v) { return write_uint(v); }
  basic_ostream& operator<<(float v) { return write_float((double)v); }
  basic_ostream& operator<<(double v) { return write_float(v); }
  basic_ostream& operator<<(long double v) { return write_long_double(v); }
  basic_ostream& operator<<(const void* v) {
    char buf[32];
    __builtin_snprintf(buf, sizeof(buf), "%p", v);
    return write_padded(buf);
  }
  basic_ostream& operator<<(nullptr_t) { return write_padded("nullptr"); }

  // Copy the source streambuf's characters to this stream.
  basic_ostream& operator<<(basic_streambuf<Char, Traits>* sb) {
    if (!sb) {
      this->setstate(ios_base::badbit);
      return *this;
    }
    auto* dst = this->rdbuf();
    streamsize count = 0;
    int_type c;
    while (!Traits::eq_int_type(c = sb->sbumpc(), Traits::eof())) {
      if (!dst || Traits::eq_int_type(dst->sputc(Traits::to_char_type(c)),
                                      Traits::eof())) {
        this->setstate(ios_base::badbit);
        break;
      }
      ++count;
    }
    if (count == 0)
      this->setstate(ios_base::failbit);
    flush_if_unitbuf();
    return *this;
  }

  basic_ostream& operator<<(char c) {
    pad_and_write(&c, 1);
    return *this;
  }
  basic_ostream& operator<<(signed char c) {
    char ch = static_cast<char>(c);
    pad_and_write(&ch, 1);
    return *this;
  }
  basic_ostream& operator<<(unsigned char c) {
    char ch = static_cast<char>(c);
    pad_and_write(&ch, 1);
    return *this;
  }
  basic_ostream& operator<<(const char* s) {
    if (s) {
      pad_and_write(s, (streamsize)__builtin_strlen(s));
    }
    return *this;
  }
  template <typename C = Char>
    requires(!is_same_v<C, char>)
  basic_ostream& operator<<(Char c) {
    pad_and_write(&c, 1);
    return *this;
  }
  template <typename C = Char>
    requires(!is_same_v<C, char>)
  basic_ostream& operator<<(const Char* s) {
    if (s) {
      streamsize n = 0;
      while (s[n])
        ++n;
      pad_and_write(s, n);
    }
    return *this;
  }
  basic_ostream& operator<<(const signed char* s) {
    return *this << reinterpret_cast<const char*>(s);
  }
  basic_ostream& operator<<(const unsigned char* s) {
    return *this << reinterpret_cast<const char*>(s);
  }
  basic_ostream& __put(const Char* s, streamsize n) {
    pad_and_write(s, n);
    return *this;
  }

protected:
  basic_ostream() { this->init(nullptr); }

private:
  void flush_if_unitbuf() {
    if (this->flags_ & ios_base::unitbuf)
      flush();
  }

  void emit(const Char* s, streamsize n) {
    auto* sb = this->rdbuf();
    if (!sb || sb->sputn(s, n) != n)
      this->setstate(ios_base::badbit);
  }

  void pad_and_write(const Char* s, streamsize n) {
    streamsize w = this->width_;
    this->width_ = 0; // width is consumed after use
    if (w <= n) {
      emit(s, n);
      flush_if_unitbuf();
      return;
    }
    streamsize pad = w - n;
    Char fc = this->fill_;
    if (this->flags_ & ios_base::left) {
      emit(s, n);
      for (streamsize i = 0; i < pad; ++i)
        emit(&fc, 1);
    } else if (this->flags_ & ios_base::internal) {
      streamsize prefix = 0;
      if (n && (s[0] == '+' || s[0] == '-'))
        prefix = 1;
      if (n >= prefix + 2 && s[prefix] == '0' &&
          (s[prefix + 1] == 'x' || s[prefix + 1] == 'X'))
        prefix += 2;
      emit(s, prefix);
      for (streamsize i = 0; i < pad; ++i)
        emit(&fc, 1);
      emit(s + prefix, n - prefix);
    } else {
      for (streamsize i = 0; i < pad; ++i)
        emit(&fc, 1);
      emit(s, n);
    }
    flush_if_unitbuf();
  }

  template <typename C = Char>
    requires(!is_same_v<C, char>)
  void pad_and_write(const char* s, streamsize n) {
    Char text[128];
    if (n > (streamsize)(sizeof(text) / sizeof(*text)))
      n = sizeof(text) / sizeof(*text);
    for (streamsize i = 0; i < n; ++i)
      text[i] = static_cast<Char>(s[i]);
    pad_and_write(text, n);
  }

  basic_ostream& write_padded(const char* s) {
    pad_and_write(s, (streamsize)__builtin_strlen(s));
    return *this;
  }

  // Write a C-locale numeric string, applying the imbued numpunct (decimal
  // point + thousands grouping of the integer part) when one is installed.
  // Default streams have no facet, so this is just pad_and_write (hot path).
  void num_write(const char* buf, int n) {
    if (!this->loc_._has_facets()) {
      pad_and_write(buf, n);
      return;
    }
    constexpr int character_kind = is_same_v<Char, char>       ? 1
                                   : is_same_v<Char, wchar_t>  ? 2
                                   : is_same_v<Char, char8_t>  ? 3
                                   : is_same_v<Char, char16_t> ? 4
                                   : is_same_v<Char, char32_t> ? 5
                                                               : 0;
    char out[80];
    int size = this->_localize_number_with_locale(out, sizeof(out), buf, n,
                                                  character_kind);
    if (size == 0)
      pad_and_write(buf, n);
    else
      pad_and_write(out, size);
  }

  template <typename V> basic_ostream& write_int(V v) {
    char buf[32];
    int n = this->_format_signed(
        buf, sizeof(buf), static_cast<long long>(v),
        static_cast<unsigned long long>(
            static_cast<typename make_unsigned<V>::type>(v)));
    if (n > 0) {
      if (this->flags_ & (ios_base::hex | ios_base::oct))
        pad_and_write(buf, n);
      else
        num_write(buf, n);
    }
    return *this;
  }

  template <typename V> basic_ostream& write_uint(V v) {
    char buf[32];
    int n = this->_format_unsigned(buf, sizeof(buf),
                                   static_cast<unsigned long long>(v));
    if (n > 0) {
      if (this->flags_ & (ios_base::hex | ios_base::oct))
        pad_and_write(buf, n);
      else
        num_write(buf, n);
    }
    return *this;
  }

  basic_ostream& write_float(double v) {
    char buf[64];
    int n = this->_format_float(buf, sizeof(buf), v);
    if (n > 0)
      num_write(buf, n);
    return *this;
  }

  basic_ostream& write_long_double(long double v) {
    char buf[64];
    int n = this->_format_long_double(buf, sizeof(buf), v);
    if (n > 0)
      num_write(buf, n);
    return *this;
  }
};

template <typename Char, typename Traits, typename T, typename D>
  requires requires(basic_ostream<Char, Traits>& stream,
                    const unique_ptr<T, D>& ptr) { stream << ptr.get(); }
basic_ostream<Char, Traits>& operator<<(basic_ostream<Char, Traits>& out,
                                        const unique_ptr<T, D>& ptr) {
  // Per the standard, character pointers are treated as C strings.
  return out << ptr.get();
}

// Manipulators
template <typename C, typename T>
basic_ostream<C, T>& endl(basic_ostream<C, T>& os) {
  os.put('\n');
  os.flush();
  return os;
}
template <typename C, typename T>
basic_ostream<C, T>& flush(basic_ostream<C, T>& os) {
  os.flush();
  return os;
}
template <typename C, typename T>
basic_ostream<C, T>& ends(basic_ostream<C, T>& os) {
  os.put(C());
  return os;
}

