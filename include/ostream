inline ios_base& unitbuf(ios_base& stream) {
  stream.setf(ios_base::unitbuf);
  return stream;
}
inline ios_base& nounitbuf(ios_base& stream) {
  stream.unsetf(ios_base::unitbuf);
  return stream;
}

template <typename Ostream, typename T>
  requires(!is_lvalue_reference_v<Ostream> &&
           is_base_of_v<ios_base, remove_reference_t<Ostream>> &&
           requires(remove_reference_t<Ostream>& stream, const T& value) {
             stream << value;
           })
Ostream&& operator<<(Ostream&& stream, const T& value) {
  stream << value;
  return static_cast<Ostream&&>(stream);
}

