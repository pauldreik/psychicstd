namespace std {

template <typename Char> class regex_traits {};

namespace regex_constants {
enum syntax_option_type : int {
  ECMAScript = 0,
  icase = REG_ICASE,
  extended = REG_EXTENDED,
};

constexpr syntax_option_type operator|(syntax_option_type lhs,
                                       syntax_option_type rhs) noexcept {
  return static_cast<syntax_option_type>(static_cast<int>(lhs) |
                                         static_cast<int>(rhs));
}
constexpr syntax_option_type operator&(syntax_option_type lhs,
                                       syntax_option_type rhs) noexcept {
  return static_cast<syntax_option_type>(static_cast<int>(lhs) &
                                         static_cast<int>(rhs));
}
constexpr syntax_option_type operator^(syntax_option_type lhs,
                                       syntax_option_type rhs) noexcept {
  return static_cast<syntax_option_type>(static_cast<int>(lhs) ^
                                         static_cast<int>(rhs));
}
constexpr syntax_option_type operator~(syntax_option_type value) noexcept {
  return static_cast<syntax_option_type>(~static_cast<int>(value));
}
constexpr syntax_option_type& operator|=(syntax_option_type& lhs,
                                         syntax_option_type rhs) noexcept {
  return lhs = lhs | rhs;
}
constexpr syntax_option_type& operator&=(syntax_option_type& lhs,
                                         syntax_option_type rhs) noexcept {
  return lhs = lhs & rhs;
}
constexpr syntax_option_type& operator^=(syntax_option_type& lhs,
                                         syntax_option_type rhs) noexcept {
  return lhs = lhs ^ rhs;
}

enum match_flag_type : int {
  match_default = 0,
  match_not_bol = REG_NOTBOL,
  match_not_eol = REG_NOTEOL,
};

constexpr match_flag_type operator|(match_flag_type lhs,
                                    match_flag_type rhs) noexcept {
  return static_cast<match_flag_type>(static_cast<int>(lhs) |
                                      static_cast<int>(rhs));
}
constexpr match_flag_type operator&(match_flag_type lhs,
                                    match_flag_type rhs) noexcept {
  return static_cast<match_flag_type>(static_cast<int>(lhs) &
                                      static_cast<int>(rhs));
}
constexpr match_flag_type operator^(match_flag_type lhs,
                                    match_flag_type rhs) noexcept {
  return static_cast<match_flag_type>(static_cast<int>(lhs) ^
                                      static_cast<int>(rhs));
}
constexpr match_flag_type operator~(match_flag_type value) noexcept {
  return static_cast<match_flag_type>(~static_cast<int>(value));
}
constexpr match_flag_type& operator|=(match_flag_type& lhs,
                                      match_flag_type rhs) noexcept {
  return lhs = lhs | rhs;
}
constexpr match_flag_type& operator&=(match_flag_type& lhs,
                                      match_flag_type rhs) noexcept {
  return lhs = lhs & rhs;
}
constexpr match_flag_type& operator^=(match_flag_type& lhs,
                                      match_flag_type rhs) noexcept {
  return lhs = lhs ^ rhs;
}
} // namespace regex_constants

class regex {
public:
  using flag_type = regex_constants::syntax_option_type;
  static constexpr flag_type ECMAScript = regex_constants::ECMAScript;
  static constexpr flag_type icase = regex_constants::icase;
  static constexpr flag_type extended = regex_constants::extended;

  regex();
  explicit regex(const string& pattern, flag_type flags = ECMAScript);
  explicit regex(const char* pattern, flag_type flags = ECMAScript);
  ~regex();

  regex(const regex&) = delete;
  regex& operator=(const regex&) = delete;
  regex(regex&&) noexcept;

  bool valid() const noexcept { return valid_; }
  const ::regex_t& native() const noexcept { return re_; }

private:
  ::regex_t re_{};
  bool valid_;
};

template <typename Char, typename Traits = regex_traits<Char>>
using basic_regex = regex;

class __regex_sub_match {
public:
  __regex_sub_match() = default;
  __regex_sub_match(string value, bool matched)
      : value_(static_cast<string&&>(value)), matched_(matched) {}

  string str() const { return value_; }
  size_t length() const noexcept { return value_.size(); }
  operator string() const { return value_; }
  bool matched() const noexcept { return matched_; }

private:
  string value_;
  bool matched_ = false;
};

class smatch {
public:
  smatch() = default;

  string str(size_t i = 0) const;
  size_t length(size_t i = 0) const noexcept;
  const __regex_sub_match& operator[](size_t i) const noexcept;
  size_t size() const noexcept { return matches_.size(); }
  bool empty() const noexcept { return matches_.empty(); }
  bool ready() const noexcept { return ready_; }

  void set(const string& subject, const ::regmatch_t* pm, size_t n);

private:
  vector<__regex_sub_match> matches_;
  bool ready_ = false;
};

template <typename BidirectionalIterator>
class match_results : public smatch {};

using cmatch = match_results<const char*>;
using wsmatch = smatch;

bool regex_search(const string&, smatch&, const regex&);
bool regex_search(const char*, smatch&, const regex&);
bool regex_search(const string&, const regex&);
bool regex_search(const char*, const regex&);

template <typename It>
bool regex_search(
    It first, It last, const regex& expression,
    regex_constants::match_flag_type flags = regex_constants::match_default) {
  string subject(first, last);
  if (!expression.valid())
    return false;
  return ::regexec(&expression.native(), subject.c_str(), 0, nullptr, flags) ==
         0;
}

bool regex_match(const string&, smatch&, const regex&);
bool regex_match(const char*, cmatch&, const regex&);
bool regex_match(const string&, const regex&);
bool regex_match(const char*, const regex&);
// Supports $0-$9, $&, and $$; other ECMAScript format rules are omitted.
string regex_replace(const string&, const regex&, const string&);

class sregex_token_iterator {
public:
  using iterator_category = input_iterator_tag;
  using value_type = string;
  using difference_type = ptrdiff_t;
  using pointer = const string*;
  using reference = const string&;

  sregex_token_iterator() = default;
  sregex_token_iterator(string::const_iterator first,
                        string::const_iterator last, const regex& expression,
                        int submatch = 0);

  reference operator*() const noexcept { return tokens_[position_]; }
  pointer operator->() const noexcept { return &tokens_[position_]; }
  sregex_token_iterator& operator++() {
    ++position_;
    return *this;
  }
  sregex_token_iterator operator++(int) {
    sregex_token_iterator previous = *this;
    ++*this;
    return previous;
  }

  friend bool operator==(const sregex_token_iterator& left,
                         const sregex_token_iterator& right) noexcept {
    const bool left_end = left.position_ == left.tokens_.size();
    const bool right_end = right.position_ == right.tokens_.size();
    if (left_end || right_end)
      return left_end == right_end;
    return left.position_ == right.position_ && left.tokens_ == right.tokens_;
  }

private:
  vector<string> tokens_;
  size_t position_ = 0;
};

} // namespace std
