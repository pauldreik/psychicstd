#pragma once
#include <__psychicstd_config>
#include <__psychicstd_except>
#include <regex.h>
#include <string>
#include <vector>

namespace std {

namespace regex_constants {
enum syntax_option_type : int {
  ECMAScript = 0,
  icase = REG_ICASE,
  extended = REG_EXTENDED,
};

constexpr syntax_option_type operator|(syntax_option_type lhs,
                                       syntax_option_type rhs) noexcept {
  return static_cast<syntax_option_type>(static_cast<int>(lhs) |
                                         static_cast<int>(rhs));
}
constexpr syntax_option_type operator&(syntax_option_type lhs,
                                       syntax_option_type rhs) noexcept {
  return static_cast<syntax_option_type>(static_cast<int>(lhs) &
                                         static_cast<int>(rhs));
}
constexpr syntax_option_type operator^(syntax_option_type lhs,
                                       syntax_option_type rhs) noexcept {
  return static_cast<syntax_option_type>(static_cast<int>(lhs) ^
                                         static_cast<int>(rhs));
}
constexpr syntax_option_type operator~(syntax_option_type value) noexcept {
  return static_cast<syntax_option_type>(~static_cast<int>(value));
}
constexpr syntax_option_type& operator|=(syntax_option_type& lhs,
                                         syntax_option_type rhs) noexcept {
  return lhs = lhs | rhs;
}
constexpr syntax_option_type& operator&=(syntax_option_type& lhs,
                                         syntax_option_type rhs) noexcept {
  return lhs = lhs & rhs;
}
constexpr syntax_option_type& operator^=(syntax_option_type& lhs,
                                         syntax_option_type rhs) noexcept {
  return lhs = lhs ^ rhs;
}

enum match_flag_type : int {
  match_default = 0,
  match_not_bol = REG_NOTBOL,
  match_not_eol = REG_NOTEOL,
};

constexpr match_flag_type operator|(match_flag_type lhs,
                                    match_flag_type rhs) noexcept {
  return static_cast<match_flag_type>(static_cast<int>(lhs) |
                                      static_cast<int>(rhs));
}
constexpr match_flag_type operator&(match_flag_type lhs,
                                    match_flag_type rhs) noexcept {
  return static_cast<match_flag_type>(static_cast<int>(lhs) &
                                      static_cast<int>(rhs));
}
constexpr match_flag_type operator^(match_flag_type lhs,
                                    match_flag_type rhs) noexcept {
  return static_cast<match_flag_type>(static_cast<int>(lhs) ^
                                      static_cast<int>(rhs));
}
constexpr match_flag_type operator~(match_flag_type value) noexcept {
  return static_cast<match_flag_type>(~static_cast<int>(value));
}
constexpr match_flag_type& operator|=(match_flag_type& lhs,
                                      match_flag_type rhs) noexcept {
  return lhs = lhs | rhs;
}
constexpr match_flag_type& operator&=(match_flag_type& lhs,
                                      match_flag_type rhs) noexcept {
  return lhs = lhs & rhs;
}
constexpr match_flag_type& operator^=(match_flag_type& lhs,
                                      match_flag_type rhs) noexcept {
  return lhs = lhs ^ rhs;
}
} // namespace regex_constants

class regex {
public:
  using flag_type = regex_constants::syntax_option_type;
  static constexpr flag_type ECMAScript = regex_constants::ECMAScript;
  static constexpr flag_type icase = regex_constants::icase;
  static constexpr flag_type extended = regex_constants::extended;

  regex();
  explicit regex(const string& pattern, flag_type flags = ECMAScript);
  explicit regex(const char* pattern, flag_type flags = ECMAScript);
  ~regex();

  regex(const regex&) = delete;
  regex& operator=(const regex&) = delete;
  regex(regex&&) noexcept;

  bool valid() const noexcept { return valid_; }
  const ::regex_t& native() const noexcept { return re_; }

private:
  ::regex_t re_{};
  bool valid_;
};

class smatch {
public:
  smatch() = default;

  string str(size_t i = 0) const;
  size_t size() const noexcept { return matches_.size(); }
  bool empty() const noexcept { return matches_.empty(); }
  bool ready() const noexcept { return ready_; }

  void set(const string& subject, const ::regmatch_t* pm, size_t n);

private:
  vector<string> matches_;
  bool ready_ = false;
};

using cmatch = smatch;
using wsmatch = smatch;

bool regex_search(const string&, smatch&, const regex&);
bool regex_search(const char*, smatch&, const regex&);
bool regex_search(const string&, const regex&);
bool regex_search(const char*, const regex&);

template <typename It>
bool regex_search(
    It first, It last, const regex& expression,
    regex_constants::match_flag_type flags = regex_constants::match_default) {
  string subject(first, last);
  if (!expression.valid())
    return false;
  return ::regexec(&expression.native(), subject.c_str(), 0, nullptr, flags) ==
         0;
}

bool regex_match(const string&, smatch&, const regex&);
bool regex_match(const string&, const regex&);
bool regex_match(const char*, const regex&);
string regex_replace(const string&, const regex&, const string&);

} // namespace std
