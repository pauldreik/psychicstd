// Stable nodes with a sorted pointer index keep lookup compact while preserving
// the iterator guarantees expected from an ordered associative container.
template <typename Key, typename Compare = less<Key>,
          typename Alloc = allocator<Key>>
class set {
  struct node {
    Key key;
    node* prev = nullptr;
    node* next = nullptr;
    explicit node(const Key& value) : key(value) {}
    explicit node(Key&& value) : key(static_cast<Key&&>(value)) {}
  };

public:
  using key_type = Key;
  using value_type = Key;
  using size_type = size_t;
  using difference_type = ptrdiff_t;
  using key_compare = Compare;
  using value_compare = Compare;
  using allocator_type = Alloc;
  using reference = const Key&;
  using const_reference = const Key&;
  class iterator {
    friend class set;
    node* node_ = nullptr;
    const set* owner_ = nullptr;
    iterator(node* value, const set* owner) : node_(value), owner_(owner) {}

  public:
    using value_type = Key;
    using difference_type = ptrdiff_t;
    using pointer = const Key*;
    using reference = const Key&;
    using iterator_category = bidirectional_iterator_tag;

    iterator() = default;
    reference operator*() const { return node_->key; }
    pointer operator->() const { return &node_->key; }
    iterator& operator++() {
      node_ = node_->next;
      return *this;
    }
    iterator operator++(int) {
      auto copy = *this;
      ++*this;
      return copy;
    }
    iterator& operator--() {
      node_ = node_ ? node_->prev : owner_->tail_;
      return *this;
    }
    iterator operator--(int) {
      auto copy = *this;
      --*this;
      return copy;
    }
    bool operator==(const iterator& other) const {
      return node_ == other.node_;
    }
    bool operator!=(const iterator& other) const {
      return node_ != other.node_;
    }
  };
  using const_iterator = iterator;
  using reverse_iterator = std::reverse_iterator<iterator>;
  using const_reverse_iterator = reverse_iterator;

  set() = default;
  explicit set(const Compare& c) : comp_(c) {}
  explicit set(const Alloc& a) : alloc_(a) {}
  set(const Compare& c, const Alloc& a) : comp_(c), alloc_(a) {}
  template <typename It> set(It first, It last) {
    for (; first != last; ++first)
      insert(*first);
  }
  template <typename It>
  set(It first, It last, const Compare& compare,
      const Alloc& allocator = Alloc())
      : comp_(compare), alloc_(allocator) {
    for (; first != last; ++first)
      insert(*first);
  }
  set(initializer_list<Key> il) {
    for (auto& v : il)
      insert(v);
  }
  set(initializer_list<Key> il, const Compare& c) : comp_(c) {
    for (auto& v : il)
      insert(v);
  }
  set(initializer_list<Key> il, const Compare& c, const Alloc& a)
      : comp_(c), alloc_(a) {
    for (auto& v : il)
      insert(v);
  }
  set(initializer_list<Key> il, const Alloc& a) : alloc_(a) {
    for (auto& v : il)
      insert(v);
  }
  set(const set& other) : comp_(other.comp_), alloc_(other.alloc_) {
    insert(other.begin(), other.end());
  }
  set(set&& other) noexcept(is_nothrow_move_constructible_v<Compare> &&
                            is_nothrow_move_constructible_v<Alloc>)
      : data_(static_cast<__ptr_index<node>&&>(other.data_)),
        head_(other.head_), tail_(other.tail_),
        comp_(static_cast<Compare&&>(other.comp_)),
        alloc_(static_cast<Alloc&&>(other.alloc_)) {
    other.head_ = other.tail_ = nullptr;
  }
  ~set() { clear(); }
  set& operator=(const set& other) {
    if (this != &other) {
      clear();
      comp_ = other.comp_;
      insert(other.begin(), other.end());
    }
    return *this;
  }
  set& operator=(set&& other) noexcept {
    swap(other);
    return *this;
  }
  set& operator=(initializer_list<Key> il) {
    clear();
    for (auto& v : il)
      insert(v);
    return *this;
  }

  iterator begin() const noexcept { return {head_, this}; }
  iterator end() const noexcept { return {nullptr, this}; }
  const_iterator cbegin() const noexcept { return begin(); }
  const_iterator cend() const noexcept { return end(); }
  reverse_iterator rbegin() const noexcept { return reverse_iterator(end()); }
  reverse_iterator rend() const noexcept { return reverse_iterator(begin()); }
  const_reverse_iterator crbegin() const noexcept {
    return const_reverse_iterator(cend());
  }
  const_reverse_iterator crend() const noexcept {
    return const_reverse_iterator(cbegin());
  }

  [[gnu::always_inline]] bool empty() const noexcept { return data_.empty(); }
  [[gnu::always_inline]] size_type size() const noexcept {
    return data_.size();
  }
  size_type max_size() const noexcept { return data_.max_size(); }

  pair<iterator, bool> insert(const Key& k) { return insert_(k); }
  pair<iterator, bool> insert(Key&& k) {
    return insert_(static_cast<Key&&>(k));
  }
  // Hint versions (hint ignored for sorted-vector implementation)
  iterator insert(const_iterator, const Key& k) { return insert(k).first; }
  iterator insert(const_iterator, Key&& k) {
    return insert(static_cast<Key&&>(k)).first;
  }
  template <typename It> void insert(It first, It last) {
    for (; first != last; ++first)
      insert(*first);
  }
  void insert(initializer_list<Key> il) {
    for (auto& v : il)
      insert(v);
  }

  template <typename... Args> pair<iterator, bool> emplace(Args&&... args) {
    return insert(Key(static_cast<Args&&>(args)...));
  }

  iterator erase(const_iterator pos) {
    node* value = pos.node_;
    iterator result{value->next, this};
    unlink_(value);
    auto index = lower_bound_index_(value->key);
    data_.erase(index);
    delete value;
    return result;
  }
  iterator erase(const_iterator first, const_iterator last) {
    if (first == last)
      return last;
    const auto first_index = lower_bound_index_(first.node_->key);
    const auto last_index =
        last == end() ? data_.size() : lower_bound_index_(last.node_->key);
    node* before = first.node_->prev;
    node* after = last.node_;
    if (before)
      before->next = after;
    else
      head_ = after;
    if (after)
      after->prev = before;
    else
      tail_ = before;
    for (node* value = first.node_; value != after;) {
      node* next = value->next;
      delete value;
      value = next;
    }
    data_.erase(first_index, last_index);
    return last;
  }
  size_type erase(const Key& k) {
    // Pointer keys need equality lookup: operator< on unrelated pointers is
    // not a portable ordering, while std::less<T*> must still support them.
    if constexpr (is_pointer_v<Key>) {
      for (auto* value : data_) {
        if (!comp_(value->key, k) && !comp_(k, value->key)) {
          erase(iterator{value, this});
          return 1;
        }
      }
    }
    auto it = lower_bound(k);
    if (it == end() || comp_(k, *it))
      return 0;
    erase(it);
    return 1;
  }
  void clear() noexcept {
    for (auto* value : data_)
      delete value;
    data_.clear();
    head_ = tail_ = nullptr;
  }
  void swap(set& other) noexcept {
    data_.swap(other.data_);
    std::swap(head_, other.head_);
    std::swap(tail_, other.tail_);
    std::swap(comp_, other.comp_);
  }
  // Rebuilds nodes and therefore requires movable keys.
  void merge(set& source) {
    for (auto current = source.begin(); current != source.end();) {
      auto next = current;
      ++next;
      if (!contains(*current)) {
        insert(static_cast<Key&&>(current.node_->key));
        source.erase(current);
      }
      current = next;
    }
  }
  void merge(set&& source) { merge(source); }

  iterator find(const Key& k) const {
    auto it = lower_bound(k);
    if (it != end() && !comp_(k, *it))
      return it;
    return end();
  }
  template <typename K>
    requires requires { typename Compare::is_transparent; }
  iterator find(const K& k) const {
    auto it = lower_bound(k);
    if (it != end() && !comp_(k, *it))
      return it;
    return end();
  }
  size_type count(const Key& k) const { return find(k) != end() ? 1 : 0; }
  bool contains(const Key& k) const { return find(k) != end(); }

  iterator lower_bound(const Key& k) const {
    auto index = lower_bound_index_(k);
    return {index == data_.size() ? nullptr : data_[index], this};
  }
  template <typename K>
    requires requires { typename Compare::is_transparent; }
  iterator lower_bound(const K& k) const {
    auto index = lower_bound_index_(k);
    return {index == data_.size() ? nullptr : data_[index], this};
  }
  iterator upper_bound(const Key& k) const {
    auto it = lower_bound(k);
    if (it != end() && !comp_(k, *it))
      ++it;
    return it;
  }
  pair<iterator, iterator> equal_range(const Key& k) const {
    return {lower_bound(k), upper_bound(k)};
  }

  bool operator==(const set& o) const {
    if (size() != o.size())
      return false;
    auto left = begin();
    auto right = o.begin();
    for (; left != end(); ++left, ++right)
      if (!(*left == *right))
        return false;
    return true;
  }
  bool operator!=(const set& o) const { return !(*this == o); }
  bool operator<(const set& o) const {
    return lexicographical_compare(begin(), end(), o.begin(), o.end());
  }

private:
  __ptr_index<node> data_;
  node* head_ = nullptr;
  node* tail_ = nullptr;
  Compare comp_ = {};
  [[no_unique_address]] Alloc alloc_ = {};

  template <typename K> size_type lower_bound_index_(const K& key) const {
    size_type first = 0;
    size_type count = data_.size();
    while (count) {
      size_type step = count / 2;
      size_type middle = first + step;
      if (comp_(data_[middle]->key, key)) {
        first = middle + 1;
        count -= step + 1;
      } else {
        count = step;
      }
    }
    return first;
  }
  template <typename Value> pair<iterator, bool> insert_(Value&& key) {
    auto index = lower_bound_index_(key);
    if (index != data_.size() && !comp_(key, data_[index]->key))
      return {{data_[index], this}, false};
    __detail::__unique_owner<node> value(new node(static_cast<Value&&>(key)));
    value->prev = index ? data_[index - 1] : nullptr;
    value->next = index == data_.size() ? nullptr : data_[index];
    data_.insert(index, value.get());
    if (value->prev)
      value->prev->next = value.get();
    else
      head_ = value.get();
    if (value->next)
      value->next->prev = value.get();
    else
      tail_ = value.get();
    return {{value.release(), this}, true};
  }
  void unlink_(node* value) {
    if (value->prev)
      value->prev->next = value->next;
    else
      head_ = value->next;
    if (value->next)
      value->next->prev = value->prev;
    else
      tail_ = value->prev;
  }
};

// multiset
template <typename Key, typename Compare = less<Key>,
          typename Alloc = allocator<Key>>
class multiset {
  struct node {
    Key key;
    node* prev = nullptr;
    node* next = nullptr;
    explicit node(const Key& value) : key(value) {}
    explicit node(Key&& value) : key(static_cast<Key&&>(value)) {}
  };

public:
  using key_type = Key;
  using value_type = Key;
  using size_type = size_t;
  using key_compare = Compare;
  using value_compare = Compare;
  using allocator_type = Alloc;
  using difference_type = ptrdiff_t;
  using reference = const Key&;
  using const_reference = const Key&;
  class iterator {
    friend class multiset;
    node* node_ = nullptr;
    const multiset* owner_ = nullptr;
    iterator(node* value, const multiset* owner)
        : node_(value), owner_(owner) {}

  public:
    using value_type = Key;
    using difference_type = ptrdiff_t;
    using pointer = const Key*;
    using reference = const Key&;
    using iterator_category = bidirectional_iterator_tag;

    iterator() = default;
    reference operator*() const { return node_->key; }
    pointer operator->() const { return &node_->key; }
    iterator& operator++() {
      node_ = node_->next;
      return *this;
    }
    iterator operator++(int) {
      auto copy = *this;
      ++*this;
      return copy;
    }
    iterator& operator--() {
      node_ = node_ ? node_->prev : owner_->tail_;
      return *this;
    }
    iterator operator--(int) {
      auto copy = *this;
      --*this;
      return copy;
    }
    bool operator==(const iterator& other) const {
      return node_ == other.node_;
    }
    bool operator!=(const iterator& other) const {
      return node_ != other.node_;
    }
  };
  using const_iterator = iterator;
  using reverse_iterator = std::reverse_iterator<iterator>;
  using const_reverse_iterator = reverse_iterator;

  multiset() = default;
  explicit multiset(const Compare& comp) : comp_(comp) {}
  explicit multiset(const Alloc& alloc) : alloc_(alloc) {}
  multiset(const Compare& comp, const Alloc& alloc)
      : comp_(comp), alloc_(alloc) {}
  multiset(initializer_list<Key> il) {
    for (const auto& v : il)
      insert(v);
  }
  template <typename It> multiset(It first, It last) {
    for (; first != last; ++first)
      insert(*first);
  }
  multiset(const multiset& other) : comp_(other.comp_), alloc_(other.alloc_) {
    insert(other.begin(), other.end());
  }
  multiset(multiset&& other) noexcept(
      is_nothrow_move_constructible_v<Compare> &&
      is_nothrow_move_constructible_v<Alloc>)
      : data_(static_cast<__ptr_index<node>&&>(other.data_)),
        head_(other.head_), tail_(other.tail_),
        comp_(static_cast<Compare&&>(other.comp_)),
        alloc_(static_cast<Alloc&&>(other.alloc_)) {
    other.head_ = other.tail_ = nullptr;
  }
  ~multiset() { clear(); }
  multiset& operator=(const multiset& other) {
    if (this != &other) {
      clear();
      comp_ = other.comp_;
      insert(other.begin(), other.end());
    }
    return *this;
  }
  multiset& operator=(multiset&& other) noexcept {
    swap(other);
    return *this;
  }

  iterator begin() const noexcept { return {head_, this}; }
  iterator end() const noexcept { return {nullptr, this}; }
  const_iterator cbegin() const noexcept { return begin(); }
  const_iterator cend() const noexcept { return end(); }
  reverse_iterator rbegin() const noexcept { return reverse_iterator(end()); }
  reverse_iterator rend() const noexcept { return reverse_iterator(begin()); }
  const_reverse_iterator crbegin() const noexcept {
    return const_reverse_iterator(cend());
  }
  const_reverse_iterator crend() const noexcept {
    return const_reverse_iterator(cbegin());
  }
  [[gnu::always_inline]] bool empty() const noexcept { return data_.empty(); }
  [[gnu::always_inline]] size_type size() const noexcept {
    return data_.size();
  }
  size_type max_size() const noexcept { return data_.max_size(); }
  void clear() noexcept {
    for (auto* value : data_)
      delete value;
    data_.clear();
    head_ = tail_ = nullptr;
  }
  void swap(multiset& other) noexcept {
    data_.swap(other.data_);
    std::swap(head_, other.head_);
    std::swap(tail_, other.tail_);
    std::swap(comp_, other.comp_);
  }

  iterator insert(const Key& k) { return insert_(k); }
  iterator insert(Key&& k) { return insert_(static_cast<Key&&>(k)); }
  iterator insert(const_iterator, const Key& k) { return insert(k); }
  iterator insert(const_iterator, Key&& k) {
    return insert(static_cast<Key&&>(k));
  }
  template <typename It> void insert(It first, It last) {
    for (; first != last; ++first)
      insert(*first);
  }
  template <typename... Args> iterator emplace(Args&&... args) {
    return insert(Key(static_cast<Args&&>(args)...));
  }
  iterator erase(const_iterator pos) {
    node* value = pos.node_;
    iterator result{value->next, this};
    auto index = lower_bound_index_(value->key);
    while (data_[index] != value)
      ++index;
    unlink_(value);
    data_.erase(index);
    delete value;
    return result;
  }
  iterator erase(const_iterator first, const_iterator last) {
    if (first == last)
      return last;
    auto first_index = lower_bound_index_(first.node_->key);
    while (data_[first_index] != first.node_)
      ++first_index;
    node* before = first.node_->prev;
    node* after = last.node_;
    size_type count = 0;
    for (node* value = first.node_; value != after;) {
      node* next = value->next;
      delete value;
      value = next;
      ++count;
    }
    if (before)
      before->next = after;
    else
      head_ = after;
    if (after)
      after->prev = before;
    else
      tail_ = before;
    data_.erase(first_index, first_index + count);
    return last;
  }
  size_type erase(const Key& k) {
    const auto first_index = lower_bound_index_(k);
    const auto last_index = upper_bound_index_(k);
    const auto result = last_index - first_index;
    if (result)
      erase(iterator{data_[first_index], this},
            iterator{last_index == data_.size() ? nullptr : data_[last_index],
                     this});
    return result;
  }
  size_type count(const Key& k) const {
    return upper_bound_index_(k) - lower_bound_index_(k);
  }
  iterator find(const Key& k) const {
    auto it = lower_bound(k);
    if (it != end() && !comp_(k, *it))
      return it;
    return end();
  }
  iterator lower_bound(const Key& k) const {
    auto index = lower_bound_index_(k);
    return {index == data_.size() ? nullptr : data_[index], this};
  }
  iterator upper_bound(const Key& k) const {
    auto index = upper_bound_index_(k);
    return {index == data_.size() ? nullptr : data_[index], this};
  }
  pair<iterator, iterator> equal_range(const Key& k) const {
    return {lower_bound(k), upper_bound(k)};
  }

private:
  __ptr_index<node> data_;
  node* head_ = nullptr;
  node* tail_ = nullptr;
  Compare comp_ = {};
  [[no_unique_address]] Alloc alloc_ = {};

  size_type lower_bound_index_(const Key& key) const {
    size_type first = 0;
    size_type count = data_.size();
    while (count) {
      size_type step = count / 2;
      size_type middle = first + step;
      if (comp_(data_[middle]->key, key)) {
        first = middle + 1;
        count -= step + 1;
      } else {
        count = step;
      }
    }
    return first;
  }
  size_type upper_bound_index_(const Key& key) const {
    size_type first = 0;
    size_type count = data_.size();
    while (count) {
      size_type step = count / 2;
      size_type middle = first + step;
      if (!comp_(key, data_[middle]->key)) {
        first = middle + 1;
        count -= step + 1;
      } else {
        count = step;
      }
    }
    return first;
  }
  template <typename Value> iterator insert_(Value&& key) {
    auto index = upper_bound_index_(key);
    __detail::__unique_owner<node> value(new node(static_cast<Value&&>(key)));
    value->prev = index ? data_[index - 1] : nullptr;
    value->next = index == data_.size() ? nullptr : data_[index];
    data_.insert(index, value.get());
    if (value->prev)
      value->prev->next = value.get();
    else
      head_ = value.get();
    if (value->next)
      value->next->prev = value.get();
    else
      tail_ = value.get();
    return {value.release(), this};
  }
  void unlink_(node* value) {
    if (value->prev)
      value->prev->next = value->next;
    else
      head_ = value->next;
    if (value->next)
      value->next->prev = value->prev;
    else
      tail_ = value->prev;
  }
};

template <typename Key, typename Compare, typename Alloc>
bool operator==(const multiset<Key, Compare, Alloc>& a,
                const multiset<Key, Compare, Alloc>& b) {
  if (a.size() != b.size())
    return false;
  auto ai = a.begin();
  auto bi = b.begin();
  for (; ai != a.end(); ++ai, ++bi)
    if (!(*ai == *bi))
      return false;
  return true;
}

// Erasing an associative-container element does not invalidate other
// iterators, so erase_if can remove matching nodes in a single pass.
template <typename Key, typename Compare, typename Alloc, typename Pred>
typename set<Key, Compare, Alloc>::size_type
erase_if(set<Key, Compare, Alloc>& c, Pred pred) {
  typename set<Key, Compare, Alloc>::size_type removed = 0;
  for (auto it = c.begin(); it != c.end();) {
    if (pred(*it)) {
      it = c.erase(it);
      ++removed;
    } else {
      ++it;
    }
  }
  return removed;
}

template <typename Key, typename Compare, typename Alloc, typename Pred>
typename multiset<Key, Compare, Alloc>::size_type
erase_if(multiset<Key, Compare, Alloc>& c, Pred pred) {
  typename multiset<Key, Compare, Alloc>::size_type removed = 0;
  for (auto it = c.begin(); it != c.end();) {
    if (pred(*it)) {
      it = c.erase(it);
      ++removed;
    } else {
      ++it;
    }
  }
  return removed;
}

