#pragma once
#include <type_traits>

namespace std {

enum class endian {
  little = 0x1234,
  big = 0x4321,
#if __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
  native = little,
#elif __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
  native = big,
#else
  native = 0x3412,
#endif
};

template <typename To, typename From>
  requires(sizeof(To) == sizeof(From) && is_trivially_copyable_v<To> &&
           is_trivially_copyable_v<From>)
constexpr To bit_cast(const From& from) noexcept {
  return __builtin_bit_cast(To, from);
}

template <typename T>
  requires(is_integral_v<T> && is_unsigned_v<T> &&
           !is_same_v<remove_cv_t<T>, bool>)
constexpr int bit_width(T value) noexcept {
  if (value == 0)
    return 0;
  if constexpr (sizeof(T) <= sizeof(unsigned long long)) {
    return static_cast<int>(
        sizeof(unsigned long long) * __CHAR_BIT__ -
        __builtin_clzll(static_cast<unsigned long long>(value)));
  } else {
    int width = 0;
    while (value != 0) {
      ++width;
      value >>= 1;
    }
    return width;
  }
}

template <typename T>
  requires(is_integral_v<T> && is_unsigned_v<T> &&
           !is_same_v<remove_cv_t<T>, bool>)
constexpr int countr_zero(T value) noexcept {
  if (value == 0)
    return sizeof(T) * __CHAR_BIT__;
  if constexpr (sizeof(T) <= sizeof(unsigned long long)) {
    return __builtin_ctzll(static_cast<unsigned long long>(value));
  } else {
    int count = 0;
    while ((value & 1) == 0) {
      ++count;
      value >>= 1;
    }
    return count;
  }
}

template <typename T>
  requires(is_integral_v<T> && is_unsigned_v<T> &&
           !is_same_v<remove_cv_t<T>, bool>)
constexpr T rotl(T value, int shift) noexcept {
  constexpr unsigned digits = sizeof(T) * __CHAR_BIT__;
  constexpr unsigned mask = digits - 1;
  const unsigned rotation = static_cast<unsigned>(shift) & mask;
  if (rotation == 0)
    return value;
  return static_cast<T>((value << rotation) | (value >> (digits - rotation)));
}

template <typename T>
  requires(is_integral_v<T> && is_unsigned_v<T> &&
           !is_same_v<remove_cv_t<T>, bool>)
constexpr T rotr(T value, int shift) noexcept {
  constexpr unsigned digits = sizeof(T) * __CHAR_BIT__;
  constexpr unsigned mask = digits - 1;
  const unsigned rotation = static_cast<unsigned>(shift) & mask;
  if (rotation == 0)
    return value;
  return static_cast<T>((value >> rotation) | (value << (digits - rotation)));
}

} // namespace std
