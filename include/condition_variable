#pragma once
#include <chrono>
#include <mutex>

namespace std {

enum class cv_status { no_timeout, timeout };

struct condition_variable {
  constexpr condition_variable() noexcept = default;
  ~condition_variable();
  condition_variable(const condition_variable&) = delete;
  condition_variable& operator=(const condition_variable&) = delete;

  void notify_one() noexcept;
  void notify_all() noexcept;

  void wait(unique_lock<mutex>& lock) noexcept;
  template <typename Predicate>
  void wait(unique_lock<mutex>& lock, Predicate pred) {
    while (!pred())
      wait(lock);
  }

  template <typename Rep, typename Period>
  cv_status wait_for(unique_lock<mutex>& lock,
                     const chrono::duration<Rep, Period>& duration) noexcept {
    return wait_until(lock, chrono::steady_clock::now() + duration);
  }
  template <typename Rep, typename Period, typename Predicate>
  bool wait_for(unique_lock<mutex>& lock,
                const chrono::duration<Rep, Period>& duration, Predicate pred) {
    return wait_until(lock, chrono::steady_clock::now() + duration, pred);
  }

  template <typename Clock, typename Duration>
  cv_status
  wait_until(unique_lock<mutex>& lock,
             const chrono::time_point<Clock, Duration>& timeout) noexcept {
    while (true) {
      auto now = Clock::now();
      if (timeout <= now)
        return cv_status::timeout;
      cv_status result = __wait_for(lock, timeout - now);
      if (result == cv_status::no_timeout || Clock::now() >= timeout)
        return result;
    }
  }
  template <typename Clock, typename Duration, typename Predicate>
  bool wait_until(unique_lock<mutex>& lock,
                  const chrono::time_point<Clock, Duration>& timeout,
                  Predicate pred) {
    while (!pred()) {
      if (wait_until(lock, timeout) == cv_status::timeout)
        return pred();
    }
    return true;
  }

private:
  template <typename Rep, typename Period>
  cv_status __wait_for(unique_lock<mutex>& lock,
                       const chrono::duration<Rep, Period>& duration) noexcept {
    long long ns = chrono::duration_cast<chrono::nanoseconds>(duration).count();
    return __wait_for_ns(lock, ns);
  }
  cv_status __wait_for_ns(unique_lock<mutex>& lock, long long ns) noexcept;

  pthread_cond_t condition_ = PTHREAD_COND_INITIALIZER;
};

class condition_variable_any {
public:
  condition_variable_any() = default;
  condition_variable_any(const condition_variable_any&) = delete;
  condition_variable_any& operator=(const condition_variable_any&) = delete;

  void notify_one() noexcept {
    lock_guard<mutex> guard(mutex_);
    condition_.notify_one();
  }
  void notify_all() noexcept {
    lock_guard<mutex> guard(mutex_);
    condition_.notify_all();
  }

  template <typename Lock> void wait(Lock& lock) {
    unique_lock<mutex> guard(mutex_);
    lock.unlock();
    condition_.wait(guard);
    guard.unlock();
    lock.lock();
  }
  template <typename Lock, typename Predicate>
  void wait(Lock& lock, Predicate pred) {
    while (!pred())
      wait(lock);
  }

  template <typename Lock, typename Clock, typename Duration>
  cv_status wait_until(Lock& lock,
                       const chrono::time_point<Clock, Duration>& timeout) {
    unique_lock<mutex> guard(mutex_);
    lock.unlock();
    cv_status result = condition_.wait_until(guard, timeout);
    guard.unlock();
    lock.lock();
    return result;
  }
  template <typename Lock, typename Clock, typename Duration,
            typename Predicate>
  bool wait_until(Lock& lock,
                  const chrono::time_point<Clock, Duration>& timeout,
                  Predicate pred) {
    while (!pred()) {
      if (wait_until(lock, timeout) == cv_status::timeout)
        return pred();
    }
    return true;
  }

  template <typename Lock, typename Rep, typename Period>
  cv_status wait_for(Lock& lock,
                     const chrono::duration<Rep, Period>& duration) {
    return wait_until(lock, chrono::steady_clock::now() + duration);
  }
  template <typename Lock, typename Rep, typename Period, typename Predicate>
  bool wait_for(Lock& lock, const chrono::duration<Rep, Period>& duration,
                Predicate pred) {
    return wait_until(lock, chrono::steady_clock::now() + duration, pred);
  }

private:
  mutex mutex_;
  condition_variable condition_;
};

} // namespace std
