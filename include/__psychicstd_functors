#pragma once
#include <__psychicstd_equal_to>
#include <__psychicstd_hash>
#include <__psychicstd_ordering>
// Functor structs and scalar hash specializations split out of <functional> so
// containers can pick them up without the heavier functional machinery.
#include <cstddef>

namespace std {

// Comparison functors
template <typename T = void> struct less_equal {
  [[gnu::always_inline]] constexpr bool operator()(const T& a,
                                                   const T& b) const {
    return a <= b;
  }
};
template <> struct less_equal<void> {
  template <typename T, typename U>
  constexpr auto operator()(T&& a, U&& b) const
      -> decltype(static_cast<T&&>(a) <= static_cast<U&&>(b)) {
    return static_cast<T&&>(a) <= static_cast<U&&>(b);
  }
  using is_transparent = void;
};
template <typename T = void> struct greater_equal {
  [[gnu::always_inline]] constexpr bool operator()(const T& a,
                                                   const T& b) const {
    return a >= b;
  }
};
template <> struct greater_equal<void> {
  template <typename T, typename U>
  constexpr auto operator()(T&& a, U&& b) const
      -> decltype(static_cast<T&&>(a) >= static_cast<U&&>(b)) {
    return static_cast<T&&>(a) >= static_cast<U&&>(b);
  }
  using is_transparent = void;
};
template <typename T = void> struct not_equal_to {
  [[gnu::always_inline]] constexpr bool operator()(const T& a,
                                                   const T& b) const {
    return a != b;
  }
};
template <> struct not_equal_to<void> {
  template <typename T, typename U>
  constexpr auto operator()(T&& a, U&& b) const {
    return static_cast<T&&>(a) != static_cast<U&&>(b);
  }
  using is_transparent = void;
};

