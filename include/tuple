namespace std {

template <size_t Index, typename T>
using tuple_element_t = typename tuple_element<Index, T>::type;

// --- tuple implementation using recursive inheritance ---

namespace detail {
template <size_t Index, typename T> struct tuple_leaf {
  T value;
  constexpr tuple_leaf() = default;
  constexpr explicit tuple_leaf(const T& v) : value(v) {}
  constexpr explicit tuple_leaf(T&& v) : value(static_cast<T&&>(v)) {}
  template <typename U>
  constexpr explicit tuple_leaf(U&& v) : value(static_cast<U&&>(v)) {}
};
// Reference-type specialisation: value is a reference, so assign through it.
template <size_t Index, typename T> struct tuple_leaf<Index, T&> {
  T& value;
  explicit tuple_leaf(T& v) : value(v) {}
  tuple_leaf(const tuple_leaf&) = default;
  tuple_leaf(tuple_leaf&&) = default;
  tuple_leaf& operator=(const tuple_leaf& o) {
    value = o.value;
    return *this;
  }
  tuple_leaf& operator=(tuple_leaf&& o) {
    value = o.value;
    return *this;
  }
};

template <typename Indices, typename... Ts> struct tuple_impl;

template <size_t... Is, typename... Ts>
struct tuple_impl<index_sequence<Is...>, Ts...> : tuple_leaf<Is, Ts>... {
  constexpr tuple_impl() = default;
  template <typename... Us>
  constexpr explicit tuple_impl(Us&&... args)
      : tuple_leaf<Is, Ts>(static_cast<Us&&>(args))... {}
};
}

template <typename... Ts>
class tuple
    : public detail::tuple_impl<make_index_sequence<sizeof...(Ts)>, Ts...> {
  using base = detail::tuple_impl<make_index_sequence<sizeof...(Ts)>, Ts...>;

public:
  constexpr tuple() = default;
  constexpr tuple(const tuple&) = default;
  constexpr tuple(tuple&&) = default;
  tuple& operator=(const tuple&) = default;
  tuple& operator=(tuple&&) = default;

  // Assign from pair (for tuple<T&, U&> = pair<T, U> pattern used by tie)
  template <typename U1, typename U2>
    requires(sizeof...(Ts) == 2)
  tuple& operator=(const pair<U1, U2>& p) {
    get<0>(*this) = p.first;
    get<1>(*this) = p.second;
    return *this;
  }

  template <typename U1, typename U2>
    requires(sizeof...(Ts) == 2)
  tuple& operator=(pair<U1, U2>&& p) {
    get<0>(*this) = static_cast<U1&&>(p.first);
    get<1>(*this) = static_cast<U2&&>(p.second);
    return *this;
  }

  // Non-template constructor: allows {} to initialise individual element
  // types. Takes const Ts& (not Ts&&) per [tuple.cnstr]; with Ts&& an rvalue
  // argument needing a conversion (e.g. string literal -> const char*) ties
  // with the forwarding template below and the call becomes ambiguous.
  // Never explicit: Ts is nearly always convertible to itself.
  constexpr tuple(const Ts&... args)
    requires(sizeof...(Ts) != 0 && (is_copy_constructible_v<Ts> && ...))
      : base(args...) {}

  // Excludes the sizeof...(Ts) == 1 case where the single argument is itself
  // a tuple, so it doesn't hijack the copy/move/converting constructors.
  template <typename... Us>
    requires(sizeof...(Us) == sizeof...(Ts) && sizeof...(Ts) != 0 &&
             !(sizeof...(Us) == 1 &&
               (is_same_v<remove_cvref_t<Us>, tuple> || ...)) &&
             (is_constructible_v<Ts, Us &&> && ...))
  constexpr explicit(!(is_convertible_v<Us, Ts> && ...)) tuple(Us&&... args)
      : base(static_cast<Us&&>(args)...) {}

  template <typename... Us>
    requires(sizeof...(Us) == sizeof...(Ts) &&
             (is_constructible_v<Ts, const Us&> && ...))
  tuple(const tuple<Us...>& other)
      : tuple(other, make_index_sequence<sizeof...(Ts)>{}) {}

  template <typename... Us>
    requires(sizeof...(Us) == sizeof...(Ts) &&
             (is_constructible_v<Ts, Us &&> && ...))
  tuple(tuple<Us...>&& other)
      : tuple(static_cast<tuple<Us...>&&>(other),
              make_index_sequence<sizeof...(Ts)>{}) {}

  template <typename U1, typename U2>
    requires(sizeof...(Ts) == 2)
  tuple(const pair<U1, U2>& p) : base(p.first, p.second) {}

  template <typename U1, typename U2>
    requires(sizeof...(Ts) == 2)
  tuple(pair<U1, U2>&& p)
      : base(static_cast<U1&&>(p.first), static_cast<U2&&>(p.second)) {}

  // Heterogeneous assignment — needed for std::tie(a,b) = tuple<Us...>{...}
  // where Ts are reference types and Us are value types.
  template <typename... Us>
    requires(sizeof...(Us) == sizeof...(Ts))
  tuple& operator=(const tuple<Us...>& other) {
    [&]<size_t... Is>(index_sequence<Is...>) {
      ((get<Is>(*this) = get<Is>(other)), ...);
    }(make_index_sequence<sizeof...(Ts)>{});
    return *this;
  }

  template <typename... Us>
    requires(sizeof...(Us) == sizeof...(Ts))
  tuple& operator=(tuple<Us...>&& other) {
    [&]<size_t... Is>(index_sequence<Is...>) {
      ((get<Is>(*this) = get<Is>(static_cast<tuple<Us...>&&>(other))), ...);
    }(make_index_sequence<sizeof...(Ts)>{});
    return *this;
  }

private:
  // Delegating helpers for the converting constructors above — kept private
  // so a stray two-argument call can't accidentally select them.
  template <typename... Us, size_t... Is>
  tuple(const tuple<Us...>& other, index_sequence<Is...>)
      : base(static_cast<const Us&>(
            static_cast<const detail::tuple_leaf<Is, Us>&>(other).value)...) {}
  template <typename... Us, size_t... Is>
  tuple(tuple<Us...>&& other, index_sequence<Is...>)
      : base(static_cast<Us&&>(
            static_cast<detail::tuple_leaf<Is, Us>&>(other).value)...) {}
};

template <> class tuple<> {};

template <typename... Ts> tuple(Ts...) -> tuple<Ts...>;

// tuple_size
template <typename... Ts>
struct tuple_size<tuple<Ts...>> : integral_constant<size_t, sizeof...(Ts)> {};
template <typename T>
  requires requires { tuple_size<T>::value; }
struct tuple_size<const T> : tuple_size<T> {};
template <typename T>
  requires requires { tuple_size<T>::value; }
struct tuple_size<volatile T> : tuple_size<T> {};
template <typename T>
  requires requires { tuple_size<T>::value; }
struct tuple_size<const volatile T> : tuple_size<T> {};
template <typename T>
inline constexpr size_t tuple_size_v = tuple_size<T>::value;

// tuple_element
namespace detail {
#if __has_builtin(__type_pack_element)
template <size_t Index, typename... Ts> struct type_at {
  using type = __type_pack_element<Index, Ts...>;
};
#else
template <size_t Index, typename Head, typename... Tail> struct type_at {
  using type = typename type_at<Index - 1, Tail...>::type;
};
template <typename Head, typename... Tail> struct type_at<0, Head, Tail...> {
  using type = Head;
};
#endif
}

template <size_t Index, typename... Ts>
struct tuple_element<Index, tuple<Ts...>> {
  using type = typename detail::type_at<Index, Ts...>::type;
};
template <size_t Index, typename T> struct tuple_element<Index, const T> {
  using type = const typename tuple_element<Index, T>::type;
};

// get<Index>(tuple)
template <size_t Index, typename... Ts>
[[gnu::always_inline]] constexpr tuple_element_t<Index, tuple<Ts...>>&
get(tuple<Ts...>& t) noexcept {
  using Leaf = detail::tuple_leaf<Index, tuple_element_t<Index, tuple<Ts...>>>;
  return static_cast<Leaf&>(t).value;
}
template <size_t Index, typename... Ts>
[[gnu::always_inline]]
constexpr const tuple_element_t<Index, tuple<Ts...>>&
get(const tuple<Ts...>& t) noexcept {
  using Leaf = detail::tuple_leaf<Index, tuple_element_t<Index, tuple<Ts...>>>;
  return static_cast<const Leaf&>(t).value;
}
template <size_t Index, typename... Ts>
[[gnu::always_inline]]
constexpr tuple_element_t<Index, tuple<Ts...>>&&
get(tuple<Ts...>&& t) noexcept {
  using Leaf = detail::tuple_leaf<Index, tuple_element_t<Index, tuple<Ts...>>>;
  return static_cast<tuple_element_t<Index, tuple<Ts...>>&&>(
      static_cast<Leaf&>(t).value);
}
template <size_t Index, typename... Ts>
[[gnu::always_inline]]
constexpr const tuple_element_t<Index, tuple<Ts...>>&&
get(const tuple<Ts...>&& t) noexcept {
  using Leaf = detail::tuple_leaf<Index, tuple_element_t<Index, tuple<Ts...>>>;
  return static_cast<const tuple_element_t<Index, tuple<Ts...>>&&>(
      static_cast<const Leaf&>(t).value);
}

template <typename T1, typename T2>
template <typename... Args1, typename... Args2>
constexpr pair<T1, T2>::pair(piecewise_construct_t, tuple<Args1...> first_args,
                             tuple<Args2...> second_args)
    : first([&]<size_t... Is>(index_sequence<Is...>) {
        return T1(get<Is>(static_cast<tuple<Args1...>&&>(first_args))...);
      }(index_sequence_for<Args1...>{})),
      second([&]<size_t... Is>(index_sequence<Is...>) {
        return T2(get<Is>(static_cast<tuple<Args2...>&&>(second_args))...);
      }(index_sequence_for<Args2...>{})) {}

// get<T>(tuple)
namespace detail {
template <typename T, typename... Ts> constexpr size_t tuple_index_of() {
  static_assert((is_same_v<T, Ts> || ...), "type not found in tuple");
  static_assert((size_t{is_same_v<T, Ts>} + ...) == 1,
                "type must occur only once in tuple");
  return [&]<size_t... Is>(index_sequence<Is...>) {
    return ((is_same_v<T, Ts> ? Is : 0) + ...);
  }(index_sequence_for<Ts...>{});
}
}

template <typename T, typename... Ts>
[[gnu::always_inline]] constexpr T& get(tuple<Ts...>& t) noexcept {
  return get<detail::tuple_index_of<T, Ts...>()>(t);
}
template <typename T, typename... Ts>
[[gnu::always_inline]] constexpr const T& get(const tuple<Ts...>& t) noexcept {
  return get<detail::tuple_index_of<T, Ts...>()>(t);
}

// Comparison operators
namespace detail {
template <size_t Index, typename Tup>
constexpr bool tuple_lt(const Tup& a, const Tup& b) {
  if constexpr (Index == tuple_size_v<Tup>)
    return false;
  else if (get<Index>(a) < get<Index>(b))
    return true;
  else if (get<Index>(b) < get<Index>(a))
    return false;
  else
    return tuple_lt<Index + 1>(a, b);
}
}

template <typename... Ts, typename... Us>
  requires(sizeof...(Ts) == sizeof...(Us))
constexpr bool operator==(const tuple<Ts...>& a, const tuple<Us...>& b) {
  return [&]<size_t... Is>(index_sequence<Is...>) {
    return ((get<Is>(a) == get<Is>(b)) && ...);
  }(make_index_sequence<sizeof...(Ts)>{});
}
template <typename... Ts, typename... Us>
  requires(sizeof...(Ts) == sizeof...(Us))
constexpr bool operator!=(const tuple<Ts...>& a, const tuple<Us...>& b) {
  return !(a == b);
}
template <typename... Ts, typename... Us>
  requires(sizeof...(Ts) == sizeof...(Us))
constexpr auto operator<=>(const tuple<Ts...>& a, const tuple<Us...>& b) {
  return [&]<size_t... Is>(index_sequence<Is...>) {
    using result_type =
        common_comparison_category_t<decltype(__detail::__synth_three_way(
            get<Is>(a), get<Is>(b)))...>;
    result_type result = strong_ordering::equal;
    auto compare_element = [&]<size_t Index>() {
      if (result == 0)
        result = __detail::__synth_three_way(get<Index>(a), get<Index>(b));
    };
    (compare_element.template operator()<Is>(), ...);
    return result;
  }(make_index_sequence<sizeof...(Ts)>{});
}
template <typename... Ts>
constexpr bool operator<(const tuple<Ts...>& a, const tuple<Ts...>& b) {
  return detail::tuple_lt<0>(a, b);
}
template <typename... Ts>
constexpr bool operator<=(const tuple<Ts...>& a, const tuple<Ts...>& b) {
  return !(b < a);
}
template <typename... Ts>
constexpr bool operator>(const tuple<Ts...>& a, const tuple<Ts...>& b) {
  return b < a;
}
template <typename... Ts>
constexpr bool operator>=(const tuple<Ts...>& a, const tuple<Ts...>& b) {
  return !(a < b);
}

// make_tuple
template <typename... Ts>
constexpr tuple<unwrap_ref_decay_t<Ts>...> make_tuple(Ts&&... args) {
  return tuple<unwrap_ref_decay_t<Ts>...>(static_cast<Ts&&>(args)...);
}

// forward_as_tuple
template <typename... Ts>
constexpr tuple<Ts&&...> forward_as_tuple(Ts&&... args) noexcept {
  return tuple<Ts&&...>(static_cast<Ts&&>(args)...);
}

// tie
template <typename... Ts> constexpr tuple<Ts&...> tie(Ts&... args) noexcept {
  return tuple<Ts&...>(args...);
}

// ignore
struct _ignore_t {
  template <typename T> const _ignore_t& operator=(const T&) const {
    return *this;
  }
};
inline constexpr _ignore_t ignore{};

namespace detail {
template <typename Tuple, size_t... Indices>
constexpr auto tuple_cat_one(Tuple&& value, index_sequence<Indices...>) {
  using source = remove_cvref_t<Tuple>;
  return tuple<tuple_element_t<Indices, source>...>(
      get<Indices>(static_cast<Tuple&&>(value))...);
}

template <typename First, typename Second, size_t... FirstIndices,
          size_t... SecondIndices>
constexpr auto tuple_cat_two(First&& first, Second&& second,
                             index_sequence<FirstIndices...>,
                             index_sequence<SecondIndices...>) {
  using first_type = remove_cvref_t<First>;
  using second_type = remove_cvref_t<Second>;
  return tuple<tuple_element_t<FirstIndices, first_type>...,
               tuple_element_t<SecondIndices, second_type>...>(
      get<FirstIndices>(static_cast<First&&>(first))...,
      get<SecondIndices>(static_cast<Second&&>(second))...);
}

template <typename Tuples, typename ElementIndices, typename TupleIndices,
          size_t NextTuple, typename... Sequences>
struct tuple_cat_indices;

template <typename Tuples, size_t... ElementIndices, size_t... TupleIndices,
          size_t NextTuple>
struct tuple_cat_indices<Tuples, index_sequence<ElementIndices...>,
                         index_sequence<TupleIndices...>, NextTuple> {
  using type = tuple<tuple_element_t<
      ElementIndices,
      remove_cvref_t<tuple_element_t<TupleIndices, Tuples>>>...>;
  using element_indices = index_sequence<ElementIndices...>;
  using tuple_indices = index_sequence<TupleIndices...>;
};

template <typename Tuples, size_t... ElementIndices, size_t... TupleIndices,
          size_t NextTuple, size_t... NextIndices, typename... Rest>
struct tuple_cat_indices<Tuples, index_sequence<ElementIndices...>,
                         index_sequence<TupleIndices...>, NextTuple,
                         index_sequence<NextIndices...>, Rest...>
    : tuple_cat_indices<
          Tuples, index_sequence<ElementIndices..., NextIndices...>,
          index_sequence<TupleIndices..., (NextTuple + 0 * NextIndices)...>,
          NextTuple + 1, Rest...> {};

template <typename Result, typename Tuples, size_t... ElementIndices,
          size_t... TupleIndices>
constexpr Result tuple_cat_many(index_sequence<ElementIndices...>,
                                index_sequence<TupleIndices...>,
                                Tuples&& tuples) {
  return Result(
      get<ElementIndices>(get<TupleIndices>(static_cast<Tuples&&>(tuples)))...);
}
}

constexpr tuple<> tuple_cat() { return {}; }

template <typename Tuple> constexpr auto tuple_cat(Tuple&& value) {
  return detail::tuple_cat_one(
      static_cast<Tuple&&>(value),
      make_index_sequence<tuple_size_v<remove_cvref_t<Tuple>>>{});
}

template <typename First, typename Second>
constexpr auto tuple_cat(First&& first, Second&& second) {
  return detail::tuple_cat_two(
      static_cast<First&&>(first), static_cast<Second&&>(second),
      make_index_sequence<tuple_size_v<remove_cvref_t<First>>>{},
      make_index_sequence<tuple_size_v<remove_cvref_t<Second>>>{});
}

template <typename First, typename Second, typename... Rest>
  requires(sizeof...(Rest) > 0)
constexpr auto tuple_cat(First&& first, Second&& second, Rest&&... rest) {
  using inputs = tuple<First&&, Second&&, Rest&&...>;
  using indices = detail::tuple_cat_indices<
      inputs, index_sequence<>, index_sequence<>, 0,
      make_index_sequence<tuple_size_v<remove_cvref_t<First>>>,
      make_index_sequence<tuple_size_v<remove_cvref_t<Second>>>,
      make_index_sequence<tuple_size_v<remove_cvref_t<Rest>>>...>;
  return detail::tuple_cat_many<typename indices::type>(
      typename indices::element_indices{}, typename indices::tuple_indices{},
      forward_as_tuple(static_cast<First&&>(first),
                       static_cast<Second&&>(second),
                       static_cast<Rest&&>(rest)...));
}

// apply (C++17)
template <typename F, typename Tuple>
constexpr decltype(auto) apply(F&& f, Tuple&& t) {
  return [&]<size_t... Is>(index_sequence<Is...>) -> decltype(auto) {
    return static_cast<F&&>(f)(get<Is>(static_cast<Tuple&&>(t))...);
  }(make_index_sequence<tuple_size_v<remove_reference_t<Tuple>>>{});
}

template <typename T, typename Tuple> constexpr T make_from_tuple(Tuple&& t) {
  return apply([]<typename... Args>(
                   Args&&... args) { return T(static_cast<Args&&>(args)...); },
               static_cast<Tuple&&>(t));
}

