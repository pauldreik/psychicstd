// random_device: reads from /dev/urandom
class random_device {
public:
  using result_type = unsigned int;
  random_device() = default;
  explicit random_device(const char*);
  random_device(const random_device&) = delete;
  random_device& operator=(const random_device&) = delete;

  result_type operator()();

  static constexpr result_type min() { return 0; }
  static constexpr result_type max() { return ~result_type(0); }
  double entropy() const noexcept;
};

// linear_congruential_engine (minimal, for minstd_rand)
template <typename UInt, UInt a, UInt c, UInt m>
class linear_congruential_engine {
public:
  using result_type = UInt;
  static constexpr result_type multiplier = a;
  static constexpr result_type increment = c;
  static constexpr result_type modulus = m;
  static constexpr result_type default_seed = 1;

  explicit linear_congruential_engine(result_type seed = default_seed)
      : state_(_reduce(seed)) {
    if constexpr (c == 0)
      if (state_ == 0)
        state_ = 1;
  }
  template <typename SSeq,
            typename = enable_if_t<!is_convertible_v<SSeq, result_type>>>
  explicit linear_congruential_engine(SSeq& seq) {
    seed(seq);
  }
  void seed(result_type s = default_seed) {
    state_ = _reduce(s);
    if constexpr (c == 0)
      if (state_ == 0)
        state_ = 1;
  }
  template <typename SSeq,
            typename = enable_if_t<!is_convertible_v<SSeq, result_type>>>
  void seed(SSeq& seq) {
    constexpr int word_count = m == 0 ? (sizeof(result_type) > 4 ? 2 : 1)
                                      : (m > 0xffffffffULL ? 2 : 1);
    uint32_t words[word_count + 3]{};
    seq.generate(words, words + word_count + 3);
    result_type value = words[3];
    if constexpr (word_count > 1)
      value |= static_cast<result_type>(words[4]) << 32;
    state_ = _reduce(value);
    if constexpr (c == 0)
      if (state_ == 0)
        state_ = 1;
  }

  result_type operator()() {
    using wide_type = unsigned __int128;
    wide_type next =
        static_cast<wide_type>(a) * state_ + static_cast<wide_type>(c);
    if constexpr (m == 0)
      state_ = static_cast<result_type>(next);
    else
      state_ = static_cast<result_type>(next % m);
    return state_;
  }
  void discard(unsigned long long count) {
    while (count--)
      operator()();
  }
  static constexpr result_type min() { return c == 0 ? 1 : 0; }
  static constexpr result_type max() {
    return m == 0 ? static_cast<result_type>(-1) : m - 1;
  }
  friend bool operator==(const linear_congruential_engine& lhs,
                         const linear_congruential_engine& rhs) {
    return lhs.state_ == rhs.state_;
  }

private:
  static constexpr result_type _reduce(result_type value) {
    if constexpr (m == 0)
      return value;
    else
      return value % m;
  }

  result_type state_;
};

using minstd_rand0 =
    linear_congruential_engine<uint_fast32_t, 16807, 0, 2147483647>;
using minstd_rand =
    linear_congruential_engine<uint_fast32_t, 48271, 0, 2147483647>;

// Mersenne Twister 32-bit (mt19937)
class mt19937 {
  static constexpr int N = 624, M = 397;
  static constexpr uint32_t MATRIX_A = 0x9908b0dfU;
  static constexpr uint32_t UPPER_MASK = 0x80000000U;
  static constexpr uint32_t LOWER_MASK = 0x7fffffffU;
  uint32_t mt_[N];
  int index_ = N + 1;

  void generate();

public:
  using result_type = uint32_t;
  static constexpr result_type default_seed = 5489U;
  static constexpr size_t state_size = 624;

  explicit mt19937(result_type seed = default_seed);
  template <typename SSeq,
            typename = enable_if_t<!is_convertible_v<SSeq, result_type>>>
  explicit mt19937(SSeq& seq) {
    seed(seq);
  }
  void seed(result_type);
  template <typename SSeq,
            typename = enable_if_t<!is_convertible_v<SSeq, result_type>>>
  void seed(SSeq& sq) {
    sq.generate(mt_, mt_ + N);
    index_ = N;
  }

  result_type operator()();
  void discard(unsigned long long);
  static constexpr result_type min() { return 0; }
  static constexpr result_type max() { return 0xffffffffU; }
  friend bool operator==(const mt19937&, const mt19937&);
};

using default_random_engine = mt19937;

// mt19937_64
class mt19937_64 {
  static constexpr int N = 312, M = 156;
  static constexpr uint64_t MATRIX_A = 0xb5026f5aa96619e9ULL;
  static constexpr uint64_t UPPER_MASK = 0xffffffff80000000ULL;
  static constexpr uint64_t LOWER_MASK = 0x7fffffffULL;
  uint64_t mt_[N];
  int index_ = N + 1;

  void generate();

public:
  using result_type = uint64_t;
  static constexpr result_type default_seed = 5489ULL;

  explicit mt19937_64(result_type seed = default_seed);
  template <typename SSeq,
            typename = enable_if_t<!is_convertible_v<SSeq, result_type>>>
  explicit mt19937_64(SSeq& seq) {
    seed(seq);
  }
  void seed(result_type);
  template <typename SSeq,
            typename = enable_if_t<!is_convertible_v<SSeq, result_type>>>
  void seed(SSeq& seq) {
    uint32_t words[N * 2];
    seq.generate(words, words + N * 2);
    for (int i = 0; i < N; ++i)
      mt_[i] = static_cast<uint64_t>(words[i * 2]) |
               (static_cast<uint64_t>(words[i * 2 + 1]) << 32);
    index_ = N;
  }

  result_type operator()();
  void discard(unsigned long long);
  static constexpr result_type min() { return 0; }
  static constexpr result_type max() { return ~uint64_t(0); }
  friend bool operator==(const mt19937_64&, const mt19937_64&);
};

class bernoulli_distribution {
public:
  using result_type = bool;

  class param_type {
  public:
    explicit param_type(double probability = 0.5) : probability_(probability) {}
    double p() const { return probability_; }
    friend bool operator==(const param_type& lhs, const param_type& rhs) {
      return lhs.probability_ == rhs.probability_;
    }

  private:
    double probability_;
  };

  explicit bernoulli_distribution(double probability = 0.5)
      : params_(probability) {}
  explicit bernoulli_distribution(const param_type& params) : params_(params) {}

  void reset() {}
  double p() const { return params_.p(); }
  param_type param() const { return params_; }
  void param(const param_type& params) { params_ = params; }
  static constexpr result_type min() { return false; }
  static constexpr result_type max() { return true; }

  template <typename Engine> result_type operator()(Engine& engine) {
    return operator()(engine, params_);
  }
  template <typename Engine>
  result_type operator()(Engine& engine, const param_type& params) {
    if (params.p() <= 0)
      return false;
    if (params.p() >= 1)
      return true;
    const long double offset =
        static_cast<long double>(engine() - engine.min());
    const long double range = static_cast<long double>(engine.max()) -
                              static_cast<long double>(engine.min()) + 1;
    return offset < params.p() * range;
  }

  friend bool operator==(const bernoulli_distribution& lhs,
                         const bernoulli_distribution& rhs) {
    return lhs.params_ == rhs.params_;
  }

private:
  param_type params_;
};

// uniform_int_distribution
template <typename Int>
inline constexpr Int __random_int_max =
    static_cast<Int>(static_cast<make_unsigned_t<Int>>(-1) >> is_signed_v<Int>);

template <typename Int = int> class uniform_int_distribution {
public:
  using result_type = Int;
  struct param_type {
    Int a, b;
    param_type(Int a = 0, Int b = __random_int_max<Int>) : a(a), b(b) {}
    Int min() const { return a; }
    Int max() const { return b; }
  };

  explicit uniform_int_distribution(Int a = 0, Int b = __random_int_max<Int>)
      : p_(a, b) {}
  explicit uniform_int_distribution(const param_type& p) : p_(p) {}

  template <typename Engine> result_type operator()(Engine& g) {
    return operator()(g, p_);
  }

  template <typename Engine>
  result_type operator()(Engine& g, const param_type& p) {
    using UInt = make_unsigned_t<Int>;
    constexpr UInt uint_max = static_cast<UInt>(-1);
    UInt range = static_cast<UInt>(p.b) - static_cast<UInt>(p.a);
    if (range == uint_max)
      return static_cast<Int>(g());
    ++range;
    UInt mod = static_cast<UInt>(uint_max - range + 1) % range;
    UInt val;
    do {
      val = static_cast<UInt>(g());
    } while (val < mod);
    return static_cast<Int>(val % range + static_cast<UInt>(p.a));
  }

  result_type min() const { return p_.a; }
  result_type max() const { return p_.b; }
  param_type param() const { return p_; }
  void param(const param_type& p) { p_ = p; }

private:
  param_type p_;
};

// uniform_real_distribution
template <typename Real = double> class uniform_real_distribution {
public:
  using result_type = Real;
  struct param_type {
    Real a, b;
    param_type(Real a = 0, Real b = 1) : a(a), b(b) {}
    Real min() const { return a; }
    Real max() const { return b; }
  };

  explicit uniform_real_distribution(Real a = 0, Real b = 1) : p_(a, b) {}
  explicit uniform_real_distribution(const param_type& p) : p_(p) {}

  template <typename Engine> result_type operator()(Engine& g) {
    return operator()(g, p_);
  }

  template <typename Engine>
  result_type operator()(Engine& g, const param_type& p) {
    // Generate a uniform [0,1) floating point value
    auto gmin = g.min();
    auto gmax = g.max();
    auto range = static_cast<double>(gmax) - static_cast<double>(gmin) + 1.0;
    double u = (static_cast<double>(g() - gmin)) / range;
    return static_cast<Real>(p.a + u * (p.b - p.a));
  }

  result_type min() const { return p_.a; }
  result_type max() const { return p_.b; }
  param_type param() const { return p_; }
  void param(const param_type& p) { p_ = p; }

private:
  param_type p_;
};

// normal_distribution
template <typename Real = double> class normal_distribution {
public:
  using result_type = Real;
  struct param_type {
    Real mean, stddev;
    param_type(Real mean = 0, Real stddev = 1) : mean(mean), stddev(stddev) {}
  };

  explicit normal_distribution(Real mean = 0, Real stddev = 1)
      : p_{mean, stddev} {}

  template <typename Engine> result_type operator()(Engine& g) {
    // Box-Muller transform
    uniform_real_distribution<Real> u(0, 1);
    Real u1, u2;
    do {
      u1 = u(g);
    } while (u1 == 0);
    u2 = u(g);
    return p_.stddev * static_cast<Real>(__random_detail::normal_transform(
                           static_cast<double>(u1), static_cast<double>(u2))) +
           p_.mean;
  }

  result_type mean() const { return p_.mean; }
  result_type stddev() const { return p_.stddev; }

private:
  param_type p_;
};

// discrete_distribution
template <typename IntType = int> class discrete_distribution {
public:
  using result_type = IntType;
  struct param_type {
    vector<double> probabilities{1.0};

    param_type() = default;
    template <typename InputIt>
    param_type(InputIt first, InputIt last) : probabilities(first, last) {
      normalize();
    }
    param_type(initializer_list<double> il)
        : probabilities(il.begin(), il.end()) {
      normalize();
    }
    template <typename UnaryOp>
    param_type(size_t count, double xmin, double xmax, UnaryOp fw) {
      if (count == 0) {
        probabilities.assign(1, 1.0);
      } else {
        double delta = (xmax - xmin) / static_cast<double>(count);
        probabilities.reserve(count);
        for (size_t i = 0; i < count; ++i)
          probabilities.push_back(
              fw(xmin + delta * (static_cast<double>(i) + 0.5)));
      }
      normalize();
    }

  private:
    void normalize() {
      if (probabilities.empty()) {
        probabilities.assign(1, 1.0);
        return;
      }
      double sum = 0;
      for (double w : probabilities)
        sum += w;
      if (sum <= 0) {
        for (auto& w : probabilities)
          w = 1.0 / static_cast<double>(probabilities.size());
        return;
      }
      for (auto& w : probabilities)
        w /= sum;
    }
  };

  discrete_distribution() = default;
  template <typename InputIt>
  discrete_distribution(InputIt first, InputIt last) : p_(first, last) {}
  discrete_distribution(initializer_list<double> il) : p_(il) {}
  template <typename UnaryOp>
  discrete_distribution(size_t count, double xmin, double xmax, UnaryOp fw)
      : p_(count, xmin, xmax, fw) {}
  explicit discrete_distribution(const param_type& p) : p_(p) {}

  template <typename Engine> result_type operator()(Engine& g) {
    return operator()(g, p_);
  }

  template <typename Engine>
  result_type operator()(Engine& g, const param_type& p) {
    uniform_real_distribution<double> u(0.0, 1.0);
    double target = u(g);
    double cumulative = 0.0;
    size_t n = p.probabilities.size();
    for (size_t i = 0; i + 1 < n; ++i) {
      cumulative += p.probabilities[i];
      if (target < cumulative)
        return static_cast<result_type>(i);
    }
    return static_cast<result_type>(n - 1);
  }

  vector<double> probabilities() const { return p_.probabilities; }
  param_type param() const { return p_; }
  void param(const param_type& p) { p_ = p; }
  result_type min() const { return result_type(0); }
  result_type max() const {
    return static_cast<result_type>(p_.probabilities.size() - 1);
  }

private:
  param_type p_;
};

// seed_seq
class seed_seq {
public:
  using result_type = uint32_t;
  seed_seq() = default;
  seed_seq(initializer_list<result_type> il) {
    for (auto v : il)
      push(v);
  }
  template <typename It> seed_seq(It first, It last) {
    for (; first != last; ++first)
      push(static_cast<result_type>(*first));
  }

  template <typename It> void generate(It first, It last) {
    size_t count = 0;
    for (auto it = first; it != last; ++it) {
      *it = 0x8b8b8b8bu;
      ++count;
    }
    if (count == 0)
      return;

    const size_t t = count >= 623  ? 11
                     : count >= 68 ? 7
                     : count >= 39 ? 5
                     : count >= 7  ? 3
                                   : (count - 1) / 2;
    const size_t p = (count - t) / 2;
    const size_t q = p + t;
    const size_t rounds = n_ + 1 > count ? n_ + 1 : count;
    auto at = [&](size_t i) -> decltype(auto) { return first[i]; };
    auto mix = [](result_type value) { return value ^ (value >> 27); };

    for (size_t k = 0; k < rounds; ++k) {
      result_type r1 = 1664525u * mix(at(k % count) ^ at((k + p) % count) ^
                                      at((k + count - 1) % count));
      result_type r2 = r1 + static_cast<result_type>(k % count);
      if (k == 0)
        r2 += static_cast<result_type>(n_);
      else if (k <= n_)
        r2 += v_[k - 1];
      at((k + p) % count) += r1;
      at((k + q) % count) += r2;
      at(k % count) = r2;
    }
    for (size_t k = rounds; k < rounds + count; ++k) {
      result_type r3 = 1566083941u * mix(at(k % count) + at((k + p) % count) +
                                         at((k + count - 1) % count));
      result_type r4 = r3 - static_cast<result_type>(k % count);
      at((k + p) % count) ^= r3;
      at((k + q) % count) ^= r4;
      at(k % count) = r4;
    }
  }
  [[gnu::always_inline]] size_t size() const { return n_; }
  template <typename OutIt> void param(OutIt out) const {
    for (size_t i = 0; i < n_; ++i)
      *out++ = v_[i];
  }

private:
  static constexpr size_t cap_ = 1024;
  result_type v_[cap_]{};
  size_t n_ = 0;
  void push(result_type v) {
    if (n_ < cap_)
      v_[n_++] = v;
  }
};

