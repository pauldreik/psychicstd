#pragma once
#include <cstddef>

// GCC's typeid operator requires std::type_info to be declared before use.
// The actual vtable and implementations live in libsupc++ (which we link).
namespace std {

class type_info {
public:
  virtual ~type_info();
  [[gnu::always_inline]] bool operator==(const type_info& rhs) const noexcept {
    return __name == rhs.__name || __equal(rhs);
  }
  [[gnu::always_inline]] bool operator!=(const type_info& rhs) const noexcept {
    return !operator==(rhs);
  }
  bool before(const type_info& rhs) const noexcept;
  [[gnu::always_inline]] const char* name() const noexcept {
#if defined(__APPLE__) && defined(__aarch64__)
    return reinterpret_cast<const char*>(reinterpret_cast<size_t>(__name) &
                                         ~(size_t(1) << 63));
#else
    return __name[0] == '*' ? __name + 1 : __name;
#endif
  }
  size_t hash_code() const noexcept;

protected:
  const char* __name;
  explicit type_info(const char* __n) : __name(__n) {}

private:
  bool __equal(const type_info& rhs) const noexcept;
  type_info& operator=(const type_info&) = delete;
  type_info(const type_info&) = delete;
};

} // namespace std
