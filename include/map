// One node-based implementation keeps this header small and preserves iterator
// stability for every mapped type.
template <typename Key, typename T, typename Compare, typename Alloc>
using __map_base = __map_node<Key, T, Compare, Alloc>;

template <typename Key, typename T, typename Compare = less<Key>,
          typename Alloc = allocator<pair<const Key, T>>>
class map : public __map_base<Key, T, Compare, Alloc> {
  using base = __map_base<Key, T, Compare, Alloc>;

public:
  using base::base;
  using value_type = typename base::value_type;
  map& operator=(initializer_list<value_type> values) {
    base::operator=(values);
    return *this;
  }
  void
  swap(map& other) noexcept(noexcept(declval<base&>().swap(declval<base&>()))) {
    base::swap(other);
  }
  // Rebuilds nodes and therefore requires movable mapped values.
  void merge(map& source) {
    for (auto current = source.begin(); current != source.end();) {
      auto next = current;
      ++next;
      if (!this->contains(current->first)) {
        this->try_emplace(current->first, static_cast<T&&>(current->second));
        source.erase(current);
      }
      current = next;
    }
  }
  void merge(map&& source) { merge(source); }
  friend void swap(map& a, map& b) noexcept(noexcept(a.swap(b))) { a.swap(b); }
};

template <typename Key, typename T, typename Compare, typename Alloc>
bool operator==(const map<Key, T, Compare, Alloc>& a,
                const map<Key, T, Compare, Alloc>& b) {
  if (a.size() != b.size())
    return false;
  auto ai = a.begin();
  auto bi = b.begin();
  for (; ai != a.end(); ++ai, ++bi) {
    if (!(*ai == *bi))
      return false;
  }
  return true;
}
template <typename Key, typename T, typename Compare, typename Alloc>
auto operator<=>(const map<Key, T, Compare, Alloc>& a,
                 const map<Key, T, Compare, Alloc>& b)
  requires requires(const Key& k, const T& t) {
    __detail::__synth_three_way(k, k);
    __detail::__synth_three_way(t, t);
  }
{
  using result_t = common_comparison_category_t<
      decltype(__detail::__synth_three_way(declval<const Key&>(),
                                           declval<const Key&>())),
      decltype(__detail::__synth_three_way(declval<const T&>(),
                                           declval<const T&>()))>;
  auto ai = a.begin();
  auto bi = b.begin();
  for (; ai != a.end() && bi != b.end(); ++ai, ++bi) {
    if (auto c = static_cast<result_t>(
            __detail::__synth_three_way(ai->first, bi->first));
        c != 0)
      return c;
    if (auto c = static_cast<result_t>(
            __detail::__synth_three_way(ai->second, bi->second));
        c != 0)
      return c;
  }
  return static_cast<result_t>(a.size() <=> b.size());
}

// The duplicate-key wrapper shares map's stable linked-node storage.
template <typename Key, typename T, typename Compare = less<Key>,
          typename Alloc = allocator<pair<const Key, T>>>
class multimap : public __map_base<Key, T, Compare, Alloc> {
  using base = __map_base<Key, T, Compare, Alloc>;

public:
  using typename base::const_iterator;
  using typename base::iterator;
  using typename base::size_type;
  using typename base::value_type;

  multimap() = default;
  explicit multimap(const Compare& comp) : base(comp) {}
  explicit multimap(const Alloc& alloc) : base(alloc) {}
  multimap(const Compare& comp, const Alloc& alloc) : base(comp, alloc) {}
  template <typename It>
  multimap(It first, It last, const Compare& comp = Compare(),
           const Alloc& alloc = Alloc())
      : base(comp, alloc) {
    for (; first != last; ++first)
      insert(*first);
  }
  multimap(initializer_list<value_type> values, const Compare& comp = Compare(),
           const Alloc& alloc = Alloc())
      : base(comp, alloc) {
    insert(values);
  }
  multimap(initializer_list<value_type> values, const Alloc& alloc)
      : base(alloc) {
    insert(values);
  }
  multimap(const multimap& other)
      : base(other.key_comp(), other.get_allocator()) {
    insert(other.begin(), other.end());
  }
  multimap(multimap&&) = default;
  multimap& operator=(const multimap& other) {
    if (this != &other) {
      multimap copy(other);
      swap(copy);
    }
    return *this;
  }
  multimap& operator=(multimap&&) = default;
  multimap& operator=(initializer_list<value_type> values) {
    this->clear();
    insert(values);
    return *this;
  }
  void swap(multimap& other) noexcept(
      noexcept(declval<base&>().swap(declval<base&>()))) {
    base::swap(other);
  }

  iterator insert(const value_type& value) {
    return base::__emplace_multi(value);
  }
  iterator insert(value_type&& value) {
    return base::__emplace_multi(static_cast<value_type&&>(value));
  }
  iterator insert(const_iterator, const value_type& value) {
    return insert(value);
  }
  iterator insert(const_iterator, value_type&& value) {
    return insert(static_cast<value_type&&>(value));
  }
  template <typename It> void insert(It first, It last) {
    for (; first != last; ++first)
      insert(*first);
  }
  void insert(initializer_list<value_type> values) {
    insert(values.begin(), values.end());
  }
  template <typename... Args> iterator emplace(Args&&... args) {
    return base::__emplace_multi(static_cast<Args&&>(args)...);
  }
  template <typename... Args>
  iterator emplace_hint(const_iterator, Args&&... args) {
    return emplace(static_cast<Args&&>(args)...);
  }
  size_type erase(const Key& key) { return base::__erase_multi(key); }
  size_type count(const Key& key) const {
    auto [first, last] = this->equal_range(key);
    size_type result = 0;
    while (first != last) {
      ++first;
      ++result;
    }
    return result;
  }
  using base::erase;
};

template <typename Key, typename T, typename Compare, typename Alloc>
bool operator==(const multimap<Key, T, Compare, Alloc>& a,
                const multimap<Key, T, Compare, Alloc>& b) {
  if (a.size() != b.size())
    return false;
  auto ai = a.begin();
  auto bi = b.begin();
  for (; ai != a.end(); ++ai, ++bi)
    if (!(*ai == *bi))
      return false;
  return true;
}

template <typename Key, typename T, typename Compare, typename Alloc,
          typename Pred>
typename map<Key, T, Compare, Alloc>::size_type
erase_if(map<Key, T, Compare, Alloc>& c, Pred pred) {
  typename map<Key, T, Compare, Alloc>::size_type removed = 0;
  for (auto it = c.begin(); it != c.end();) {
    if (pred(*it)) {
      it = c.erase(it);
      ++removed;
    } else {
      ++it;
    }
  }
  return removed;
}

template <typename Key, typename T, typename Compare, typename Alloc,
          typename Pred>
typename multimap<Key, T, Compare, Alloc>::size_type
erase_if(multimap<Key, T, Compare, Alloc>& c, Pred pred) {
  typename multimap<Key, T, Compare, Alloc>::size_type removed = 0;
  for (auto it = c.begin(); it != c.end();) {
    if (pred(*it)) {
      it = c.erase(it);
      ++removed;
    } else {
      ++it;
    }
  }
  return removed;
}

