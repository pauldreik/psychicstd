#pragma once
#include <__psychicstd_invoke>
#include <__psychicstd_lock_tags>
#include <pthread.h>

namespace std {

[[noreturn, gnu::cold, gnu::noinline]] void __throw_lock_error(bool deadlock);

struct mutex {
  using native_handle_type = pthread_mutex_t*;

  constexpr mutex() noexcept = default;
  ~mutex() { ::pthread_mutex_destroy(&mutex_); }
  mutex(const mutex&) = delete;
  mutex& operator=(const mutex&) = delete;
  void lock() noexcept {
    if (::pthread_mutex_lock(&mutex_) != 0)
      __builtin_trap();
  }
  bool try_lock() noexcept { return ::pthread_mutex_trylock(&mutex_) == 0; }
  void unlock() noexcept {
    if (::pthread_mutex_unlock(&mutex_) != 0)
      __builtin_trap();
  }
  native_handle_type native_handle() noexcept { return &mutex_; }

private:
  pthread_mutex_t mutex_ = PTHREAD_MUTEX_INITIALIZER;
};

struct recursive_mutex {
  using native_handle_type = pthread_mutex_t*;

  recursive_mutex() noexcept {
    pthread_mutexattr_t attributes;
    if (::pthread_mutexattr_init(&attributes) != 0)
      __builtin_trap();
    if (::pthread_mutexattr_settype(&attributes, PTHREAD_MUTEX_RECURSIVE) !=
            0 ||
        ::pthread_mutex_init(&mutex_, &attributes) != 0) {
      ::pthread_mutexattr_destroy(&attributes);
      __builtin_trap();
    }
    ::pthread_mutexattr_destroy(&attributes);
  }
  ~recursive_mutex() { ::pthread_mutex_destroy(&mutex_); }
  recursive_mutex(const recursive_mutex&) = delete;
  recursive_mutex& operator=(const recursive_mutex&) = delete;
  void lock() noexcept {
    if (::pthread_mutex_lock(&mutex_) != 0)
      __builtin_trap();
  }
  bool try_lock() noexcept { return ::pthread_mutex_trylock(&mutex_) == 0; }
  void unlock() noexcept {
    if (::pthread_mutex_unlock(&mutex_) != 0)
      __builtin_trap();
  }
  native_handle_type native_handle() noexcept { return &mutex_; }

private:
  pthread_mutex_t mutex_;
};

struct once_flag {
  constexpr once_flag() noexcept = default;
  once_flag(const once_flag&) = delete;
  once_flag& operator=(const once_flag&) = delete;

  mutex mutex_;
  bool done_ = false;
};

template <typename Mutex> struct lock_guard {
  using mutex_type = Mutex;
  explicit lock_guard(Mutex& m) : m_(m) { m_.lock(); }
  lock_guard(Mutex& m, int /*adopt_lock_t*/) : m_(m) {}
  ~lock_guard() { m_.unlock(); }
  lock_guard(const lock_guard&) = delete;
  lock_guard& operator=(const lock_guard&) = delete;

private:
  Mutex& m_;
};

template <typename Callable, typename... Args>
void call_once(once_flag& flag, Callable&& callable, Args&&... args) {
  lock_guard guard(flag.mutex_);
  if (!flag.done_) {
    detail::__invoke(static_cast<Callable&&>(callable),
                     static_cast<Args&&>(args)...);
    flag.done_ = true;
  }
}

template <typename Mutex> struct scoped_lock {
  explicit scoped_lock(Mutex& mutex) : mutex_(mutex) { mutex_.lock(); }
  ~scoped_lock() { mutex_.unlock(); }
  scoped_lock(const scoped_lock&) = delete;
  scoped_lock& operator=(const scoped_lock&) = delete;

private:
  Mutex& mutex_;
};

template <typename Mutex> struct unique_lock {
  using mutex_type = Mutex;
  unique_lock() noexcept : m_(nullptr), owns_(false) {}
  explicit unique_lock(Mutex& m) : m_(__builtin_addressof(m)), owns_(true) {
    m_->lock();
  }
  unique_lock(Mutex& m, defer_lock_t) noexcept
      : m_(__builtin_addressof(m)), owns_(false) {}
  unique_lock(Mutex& m, try_to_lock_t) noexcept
      : m_(__builtin_addressof(m)), owns_(m.try_lock()) {}
  unique_lock(Mutex& m, adopt_lock_t) noexcept
      : m_(__builtin_addressof(m)), owns_(true) {}
  ~unique_lock() {
    if (owns_)
      m_->unlock();
  }
  unique_lock(const unique_lock&) = delete;
  unique_lock& operator=(const unique_lock&) = delete;
  unique_lock(unique_lock&& o) noexcept : m_(o.m_), owns_(o.owns_) {
    o.m_ = nullptr;
    o.owns_ = false;
  }
  unique_lock& operator=(unique_lock&& o) noexcept {
    if (this == __builtin_addressof(o))
      return *this;
    if (owns_)
      m_->unlock();
    m_ = o.m_;
    owns_ = o.owns_;
    o.m_ = nullptr;
    o.owns_ = false;
    return *this;
  }
  void lock() {
    check_lockable();
    m_->lock();
    owns_ = true;
  }
  bool try_lock() {
    check_lockable();
    return owns_ = m_->try_lock();
  }
  void unlock() {
    if (!owns_)
      __throw_lock_error(false);
    m_->unlock();
    owns_ = false;
  }
  bool owns_lock() const noexcept { return owns_; }
  explicit operator bool() const noexcept { return owns_; }
  Mutex* mutex() const noexcept { return m_; }
  Mutex* release() noexcept {
    Mutex* result = m_;
    m_ = nullptr;
    owns_ = false;
    return result;
  }
  void swap(unique_lock& other) noexcept {
    Mutex* mutex = m_;
    m_ = other.m_;
    other.m_ = mutex;
    bool owns = owns_;
    owns_ = other.owns_;
    other.owns_ = owns;
  }

private:
  void check_lockable() const {
    if (!m_)
      __throw_lock_error(false);
    if (owns_)
      __throw_lock_error(true);
  }

  Mutex* m_;
  bool owns_;
};

template <typename Lock1, typename Lock2>
void lock(Lock1& first, Lock2& second) {
  for (;;) {
    first.lock();
    if (second.try_lock())
      return;
    first.unlock();

    second.lock();
    if (first.try_lock())
      return;
    second.unlock();
  }
}

}
