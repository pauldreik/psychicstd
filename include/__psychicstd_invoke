#pragma once
#include <__psychicstd_remove_cvref>

namespace std {
template <typename T> class reference_wrapper;
}

namespace std::detail {

template <typename T>
using __invoke_remove_cvref_t =
    typename __psychicstd_detail::__remove_cvref_impl<T>::type;

template <typename T> struct __is_reference_wrapper {
  static constexpr bool value = false;
};
template <typename T> struct __is_reference_wrapper<reference_wrapper<T>> {
  static constexpr bool value = true;
};

template <typename F, typename... Args>
constexpr decltype(auto) __invoke(F&& f, Args&&... args) {
  return static_cast<F&&>(f)(static_cast<Args&&>(args)...);
}
template <typename R, typename T, typename Obj, typename... Args>
constexpr decltype(auto) __invoke(R T::* pm, Obj&& obj, Args&&... args) {
  if constexpr (!requires { sizeof(R); }) {
    if constexpr (__is_base_of(T, __invoke_remove_cvref_t<Obj>))
      return (static_cast<Obj&&>(obj).*pm)(static_cast<Args&&>(args)...);
    else if constexpr (__is_reference_wrapper<
                           __invoke_remove_cvref_t<Obj>>::value)
      return (static_cast<Obj&&>(obj).get().*pm)(static_cast<Args&&>(args)...);
    else
      return ((*static_cast<Obj&&>(obj)).*pm)(static_cast<Args&&>(args)...);
  } else {
    if constexpr (__is_base_of(T, __invoke_remove_cvref_t<Obj>))
      return static_cast<Obj&&>(obj).*pm;
    else if constexpr (__is_reference_wrapper<
                           __invoke_remove_cvref_t<Obj>>::value)
      return static_cast<Obj&&>(obj).get().*pm;
    else
      return (*static_cast<Obj&&>(obj)).*pm;
  }
}

}
