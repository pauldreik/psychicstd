template <typename T, typename... Args>
shared_ptr<T> make_shared(Args&&... args) {
  // forward
  return shared_ptr<T>(new T(static_cast<Args&&>(args)...));
}

template <typename T, typename Alloc, typename... Args>
shared_ptr<T> allocate_shared(const Alloc& alloc, Args&&... args) {
  using object_alloc =
      typename allocator_traits<Alloc>::template rebind_alloc<T>;
  object_alloc object_allocator(alloc);
  using object_pointer = typename allocator_traits<object_alloc>::pointer;
  object_pointer allocation =
      allocator_traits<object_alloc>::allocate(object_allocator, 1);
  T* object = to_address(allocation);
  _PSYCHICSTD_TRY {
    allocator_traits<object_alloc>::construct(object_allocator, object,
                                              static_cast<Args&&>(args)...);
  }
  _PSYCHICSTD_CATCH(...) {
    allocator_traits<object_alloc>::deallocate(object_allocator, allocation, 1);
    _PSYCHICSTD_RETHROW;
  }
  return shared_ptr<T>(
      object, __detail::__sp_alloc_del<T, object_alloc>{
                  static_cast<object_alloc&&>(object_allocator), allocation});
}

template <typename T, typename U>
shared_ptr<T> static_pointer_cast(const shared_ptr<U>& p) noexcept {
  return shared_ptr<T>(p, static_cast<T*>(p.get()));
}
template <typename T, typename U>
shared_ptr<T> static_pointer_cast(shared_ptr<U>&& p) noexcept {
  T* result = static_cast<T*>(p.get());
  return shared_ptr<T>(static_cast<shared_ptr<U>&&>(p), result);
}
template <typename T, typename U>
shared_ptr<T> const_pointer_cast(const shared_ptr<U>& p) noexcept {
  return shared_ptr<T>(p, const_cast<T*>(p.get()));
}
template <typename T, typename U>
shared_ptr<T> const_pointer_cast(shared_ptr<U>&& p) noexcept {
  T* result = const_cast<T*>(p.get());
  return shared_ptr<T>(static_cast<shared_ptr<U>&&>(p), result);
}
template <typename T, typename U>
shared_ptr<T> dynamic_pointer_cast(const shared_ptr<U>& p) noexcept {
  T* q = dynamic_cast<T*>(p.get());
  return q ? shared_ptr<T>(p, q) : shared_ptr<T>();
}
template <typename T, typename U>
shared_ptr<T> dynamic_pointer_cast(shared_ptr<U>&& p) noexcept {
  T* result = dynamic_cast<T*>(p.get());
  return result ? shared_ptr<T>(static_cast<shared_ptr<U>&&>(p), result)
                : shared_ptr<T>();
}
template <typename T, typename U>
shared_ptr<T> reinterpret_pointer_cast(const shared_ptr<U>& p) noexcept {
  return shared_ptr<T>(p, reinterpret_cast<T*>(p.get()));
}
template <typename T, typename U>
shared_ptr<T> reinterpret_pointer_cast(shared_ptr<U>&& p) noexcept {
  T* result = reinterpret_cast<T*>(p.get());
  return shared_ptr<T>(static_cast<shared_ptr<U>&&>(p), result);
}

template <typename T> class weak_ptr {
  template <typename U> friend class weak_ptr;
  template <typename U> friend class shared_ptr;

  T* ptr_ = nullptr;
  __detail::__sp_ctrl* ctrl_ = nullptr;

  void inc() noexcept {
    if (ctrl_)
      __detail::__sp_weak_add(ctrl_);
  }
  void dec() noexcept {
    if (ctrl_)
      __detail::__sp_weak_release(ctrl_);
  }

public:
  weak_ptr() noexcept = default;

  template <typename U>
  weak_ptr(const shared_ptr<U>& sp) noexcept : ptr_(sp.ptr_), ctrl_(sp.ctrl_) {
    inc();
  }
  weak_ptr(const weak_ptr& other) noexcept
      : ptr_(other.ptr_), ctrl_(other.ctrl_) {
    inc();
  }
  template <typename U>
  weak_ptr(const weak_ptr<U>& other) noexcept : ctrl_(other.ctrl_) {
    inc();
    if (ctrl_ && __detail::__sp_strong_add_if_live(ctrl_)) {
      ptr_ = static_cast<T*>(other.ptr_);
      __detail::__sp_strong_release(ctrl_);
    }
  }
  weak_ptr(weak_ptr&& other) noexcept : ptr_(other.ptr_), ctrl_(other.ctrl_) {
    other.ptr_ = nullptr;
    other.ctrl_ = nullptr;
  }
  ~weak_ptr() { dec(); }

  weak_ptr& operator=(const weak_ptr& other) noexcept {
    weak_ptr(other).swap(*this);
    return *this;
  }
  template <typename U> weak_ptr& operator=(const weak_ptr<U>& other) noexcept {
    weak_ptr(other).swap(*this);
    return *this;
  }
  template <typename U> weak_ptr& operator=(const shared_ptr<U>& sp) noexcept {
    weak_ptr(sp).swap(*this);
    return *this;
  }

  void reset() noexcept { weak_ptr().swap(*this); }
  void swap(weak_ptr& other) noexcept {
    T* ptr = ptr_;
    __detail::__sp_ctrl* ctrl = ctrl_;
    ptr_ = other.ptr_;
    ctrl_ = other.ctrl_;
    other.ptr_ = ptr;
    other.ctrl_ = ctrl;
  }
  long use_count() const noexcept {
    return ctrl_ ? __atomic_load_n(&ctrl_->count, __ATOMIC_RELAXED) : 0;
  }
  bool expired() const noexcept { return use_count() == 0; }
  shared_ptr<T> lock() const noexcept {
    shared_ptr<T> result;
    if (ctrl_ && __detail::__sp_strong_add_if_live(ctrl_)) {
      result.ptr_ = ptr_;
      result.ctrl_ = ctrl_;
    }
    return result;
  }
  template <typename U>
  bool owner_before(const shared_ptr<U>& other) const noexcept {
    return less<__detail::__sp_ctrl*>{}(ctrl_, other.ctrl_);
  }
  template <typename U>
  bool owner_before(const weak_ptr<U>& other) const noexcept {
    return less<__detail::__sp_ctrl*>{}(ctrl_, other.ctrl_);
  }
};

template <typename T, typename D>
  requires requires(typename unique_ptr<T, D>::pointer pointer) {
    hash<typename unique_ptr<T, D>::pointer>{}(pointer);
  }
struct hash<unique_ptr<T, D>> {
  size_t operator()(const unique_ptr<T, D>& p) const
      noexcept(noexcept(hash<typename unique_ptr<T, D>::pointer>{}(p.get()))) {
    using pointer = typename unique_ptr<T, D>::pointer;
    return hash<pointer>{}(p.get());
  }
};
template <typename T> struct hash<shared_ptr<T>> {
  size_t operator()(const shared_ptr<T>& p) const noexcept {
    return hash<typename shared_ptr<T>::element_type*>{}(p.get());
  }
};

