#pragma once
#include <__psychicstd_config>
#if _PSYCHICSTD_COMPATIBILITY_LEVEL >= _PSYCHICSTD_COMPAT_DROPIN
#include <cmath>
#endif
#include <iosfwd>
#include <limits>

namespace std {

namespace __complex_detail {

template <typename T> constexpr bool isinf(T) { return false; }
constexpr bool isinf(float value) { return __builtin_isinf(value); }
constexpr bool isinf(double value) { return __builtin_isinf(value); }
constexpr bool isinf(long double value) { return __builtin_isinf(value); }

template <typename T> constexpr bool isnan(T) { return false; }
constexpr bool isnan(float value) { return __builtin_isnan(value); }
constexpr bool isnan(double value) { return __builtin_isnan(value); }
constexpr bool isnan(long double value) { return __builtin_isnan(value); }

template <typename T> constexpr T abs(T value) {
  return value < 0 ? -value : value;
}
constexpr float abs(float value) { return __builtin_fabsf(value); }
constexpr double abs(double value) { return __builtin_fabs(value); }
constexpr long double abs(long double value) { return __builtin_fabsl(value); }

template <typename T> constexpr T copysign(T value, T sign) {
  T magnitude = abs(value);
  return sign < 0 ? -magnitude : magnitude;
}
constexpr float copysign(float value, float sign) {
  return __builtin_copysignf(value, sign);
}
constexpr double copysign(double value, double sign) {
  return __builtin_copysign(value, sign);
}
constexpr long double copysign(long double value, long double sign) {
  return __builtin_copysignl(value, sign);
}

template <typename T> T atan2(T y, T x) {
  return static_cast<T>(__builtin_atan2l(static_cast<long double>(y),
                                         static_cast<long double>(x)));
}
inline float atan2(float y, float x) { return __builtin_atan2f(y, x); }
inline double atan2(double y, double x) { return __builtin_atan2(y, x); }
inline long double atan2(long double y, long double x) {
  return __builtin_atan2l(y, x);
}

template <typename T> T sqrt(T value) {
  return static_cast<T>(__builtin_sqrtl(static_cast<long double>(value)));
}
inline float sqrt(float value) { return __builtin_sqrtf(value); }
inline double sqrt(double value) { return __builtin_sqrt(value); }
inline long double sqrt(long double value) { return __builtin_sqrtl(value); }

template <typename T>
inline constexpr int floating_rank = __is_same(T, float)         ? 1
                                     : __is_same(T, double)      ? 2
                                     : __is_same(T, long double) ? 3
                                                                 : 0;

} // namespace __complex_detail

template <typename T> class complex {
public:
  using value_type = T;
  constexpr complex(T r = T(), T i = T()) : re_(r), im_(i) {}
  template <typename U>
  constexpr explicit(__complex_detail::floating_rank<T> <
                     __complex_detail::floating_rank<U>)
      complex(const complex<U>& other)
      : re_(static_cast<T>(other.real())), im_(static_cast<T>(other.imag())) {}
  template <typename U> constexpr complex& operator=(const complex<U>& other) {
    re_ = static_cast<T>(other.real());
    im_ = static_cast<T>(other.imag());
    return *this;
  }
  constexpr T real() const noexcept { return re_; }
  constexpr T imag() const noexcept { return im_; }
  constexpr void real(T r) noexcept { re_ = r; }
  constexpr void imag(T i) noexcept { im_ = i; }

  constexpr complex& operator+=(const complex& o) noexcept {
    re_ += o.re_;
    im_ += o.im_;
    return *this;
  }
  constexpr complex& operator-=(const complex& o) noexcept {
    re_ -= o.re_;
    im_ -= o.im_;
    return *this;
  }
  constexpr complex& operator*=(const complex& o) noexcept {
    T r = re_ * o.re_ - im_ * o.im_;
    im_ = re_ * o.im_ + im_ * o.re_;
    re_ = r;
    return *this;
  }
  constexpr complex& operator/=(const complex& o) noexcept {
    *this = *this / o;
    return *this;
  }
  constexpr complex& operator+=(T x) noexcept {
    re_ += x;
    return *this;
  }
  constexpr complex& operator-=(T x) noexcept {
    re_ -= x;
    return *this;
  }
  constexpr complex& operator*=(T x) noexcept {
    re_ *= x;
    im_ *= x;
    return *this;
  }
  constexpr complex& operator/=(T x) noexcept {
    re_ /= x;
    im_ /= x;
    return *this;
  }

private:
  T re_, im_;
};

template <typename T> constexpr T real(const complex<T>& c) { return c.real(); }
template <typename T> constexpr T imag(const complex<T>& c) { return c.imag(); }
template <typename T> constexpr complex<T> conj(const complex<T>& c) {
  return complex<T>(c.real(), -c.imag());
}
inline double real(double x) { return x; }
inline double imag(double) { return 0; }
inline double conj(double x) { return x; }

// --- arithmetic operators ---

template <typename T>
constexpr complex<T> operator+(const complex<T>& a, const complex<T>& b) {
  return complex<T>(a.real() + b.real(), a.imag() + b.imag());
}
template <typename T> constexpr complex<T> operator+(const complex<T>& a, T b) {
  return complex<T>(a.real() + b, a.imag());
}
template <typename T> constexpr complex<T> operator+(T a, const complex<T>& b) {
  return complex<T>(a + b.real(), b.imag());
}

template <typename T>
constexpr complex<T> operator-(const complex<T>& a, const complex<T>& b) {
  return complex<T>(a.real() - b.real(), a.imag() - b.imag());
}
template <typename T> constexpr complex<T> operator-(const complex<T>& a, T b) {
  return complex<T>(a.real() - b, a.imag());
}
template <typename T> constexpr complex<T> operator-(T a, const complex<T>& b) {
  return complex<T>(a - b.real(), -b.imag());
}
template <typename T> constexpr complex<T> operator-(const complex<T>& a) {
  return complex<T>(-a.real(), -a.imag());
}

template <typename T>
constexpr complex<T> operator*(const complex<T>& a, const complex<T>& b) {
  return complex<T>(a.real() * b.real() - a.imag() * b.imag(),
                    a.real() * b.imag() + a.imag() * b.real());
}
template <typename T> constexpr complex<T> operator*(const complex<T>& a, T b) {
  return complex<T>(a.real() * b, a.imag() * b);
}
template <typename T> constexpr complex<T> operator*(T a, const complex<T>& b) {
  return complex<T>(a * b.real(), a * b.imag());
}

// complex/complex division — robust against overflow and denom == 0.
template <typename T>
constexpr complex<T> operator/(const complex<T>& a, const complex<T>& b) {
  T cr = b.real(), ci = b.imag();
  T ar = a.real(), ai = a.imag();
  if (cr == T(0) && ci == T(0)) {
    return complex<T>(ar / cr, ai / cr);
  }
  // Division by infinity → 0; propagate NaN from denominator.
  if (__complex_detail::isinf(cr) || __complex_detail::isinf(ci)) {
    return complex<T>(__complex_detail::copysign(T(0), ar * cr),
                      __complex_detail::copysign(T(0), ai * ci));
  }
  if (__complex_detail::isnan(cr) || __complex_detail::isnan(ci)) {
    return complex<T>(std::numeric_limits<T>::quiet_NaN(),
                      std::numeric_limits<T>::quiet_NaN());
  }
  if (__complex_detail::abs(cr) >= __complex_detail::abs(ci)) {
    T r = ci / cr;
    T denom = cr + r * ci;
    return complex<T>((ar + r * ai) / denom, (ai - r * ar) / denom);
  }
  T r = cr / ci;
  T denom = cr * r + ci;
  return complex<T>((ar * r + ai) / denom, (ai * r - ar) / denom);
}
template <typename T> constexpr complex<T> operator/(const complex<T>& a, T b) {
  return complex<T>(a.real() / b, a.imag() / b);
}
template <typename T> constexpr complex<T> operator/(T a, const complex<T>& b) {
  T cr = b.real(), ci = b.imag();
  if (cr == T(0) && ci == T(0)) {
    return complex<T>(a / cr, -a / cr);
  }
  if (__complex_detail::isinf(cr) || __complex_detail::isinf(ci)) {
    return complex<T>(__complex_detail::copysign(T(0), a * cr), T(0));
  }
  if (__complex_detail::isnan(cr) || __complex_detail::isnan(ci)) {
    return complex<T>(std::numeric_limits<T>::quiet_NaN(),
                      std::numeric_limits<T>::quiet_NaN());
  }
  if (__complex_detail::abs(cr) >= __complex_detail::abs(ci)) {
    T r = ci / cr;
    T denom = cr + r * ci;
    return complex<T>(a / denom, -a * r / denom);
  }
  T r = cr / ci;
  T denom = cr * r + ci;
  return complex<T>(a * r / denom, -a / denom);
}

template <typename T>
constexpr bool operator==(const complex<T>& a, const complex<T>& b) {
  return a.real() == b.real() && a.imag() == b.imag();
}
template <typename T> constexpr bool operator==(const complex<T>& a, T b) {
  return a.real() == b && a.imag() == T();
}
template <typename T> constexpr bool operator==(T a, const complex<T>& b) {
  return a == b.real() && T() == b.imag();
}
template <typename T>
constexpr bool operator!=(const complex<T>& a, const complex<T>& b) {
  return !(a == b);
}
template <typename T> constexpr bool operator!=(const complex<T>& a, T b) {
  return !(a == b);
}
template <typename T> constexpr bool operator!=(T a, const complex<T>& b) {
  return !(a == b);
}

template <typename T> T arg(const complex<T>& c) {
  return __complex_detail::atan2(c.imag(), c.real());
}
template <typename T> T norm(const complex<T>& c) {
  return c.real() * c.real() + c.imag() * c.imag();
}
template <typename T> T abs(const complex<T>& c) {
  return __complex_detail::sqrt(norm(c));
}

// I/O
template <typename CharT, typename Traits, typename T>
basic_ostream<CharT, Traits>& operator<<(basic_ostream<CharT, Traits>& os,
                                         const complex<T>& c) {
  return os << '(' << c.real() << ',' << c.imag() << ')';
}

} // namespace std
