#pragma once

namespace std {

namespace __detail {
template <typename T, typename U>
constexpr bool __pointer_less(T* a, U* b) noexcept {
  if (__builtin_is_constant_evaluated())
    return a < b;
  return reinterpret_cast<__UINTPTR_TYPE__>(a) <
         reinterpret_cast<__UINTPTR_TYPE__>(b);
}
}

template <typename T = void> struct less {
  [[gnu::always_inline]] constexpr bool operator()(const T& a,
                                                   const T& b) const {
    return a < b;
  }
};
template <typename T> struct less<T*> {
  constexpr bool operator()(T* a, T* b) const noexcept {
    return __detail::__pointer_less(a, b);
  }
};
template <> struct less<void> {
  template <typename T, typename U>
  constexpr auto operator()(T&& a, U&& b) const
      -> decltype(static_cast<T&&>(a) < static_cast<U&&>(b)) {
    return static_cast<T&&>(a) < static_cast<U&&>(b);
  }
  using is_transparent = void;
};

template <typename T = void> struct greater {
  [[gnu::always_inline]] constexpr bool operator()(const T& a,
                                                   const T& b) const {
    return a > b;
  }
};
template <typename T> struct greater<T*> {
  constexpr bool operator()(T* a, T* b) const noexcept {
    return __detail::__pointer_less(b, a);
  }
};
template <> struct greater<void> {
  template <typename T, typename U>
  constexpr auto operator()(T&& a, U&& b) const
      -> decltype(static_cast<T&&>(a) > static_cast<U&&>(b)) {
    return static_cast<T&&>(a) > static_cast<U&&>(b);
  }
  using is_transparent = void;
};

}
