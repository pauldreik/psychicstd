#pragma once
#include <__psychicstd_allocator>
#include <__psychicstd_iterator_core>
#include <__psychicstd_iterator_next>
#include <cstddef>
#include <initializer_list>

namespace std {

template <typename T, typename Allocator = allocator<T>> class list {
  struct NodeBase {
    NodeBase* prev;
    NodeBase* next;
    NodeBase() : prev(this), next(this) {}
  };
  struct Node : NodeBase {
    T value;
    template <typename... Args>
    Node(Args&&... args) : value(static_cast<Args&&>(args)...) {}
  };

  NodeBase sentinel_;
  size_t size_ = 0;
  Allocator alloc_{};

  static Node* node(NodeBase* n) { return static_cast<Node*>(n); }
  static const Node* node(const NodeBase* n) {
    return static_cast<const Node*>(n);
  }
  void reset() {
    sentinel_.prev = sentinel_.next = &sentinel_;
    size_ = 0;
  }
  void take_nodes(list& other) {
    if (other.empty())
      return;
    sentinel_.next = other.sentinel_.next;
    sentinel_.prev = other.sentinel_.prev;
    sentinel_.next->prev = &sentinel_;
    sentinel_.prev->next = &sentinel_;
    size_ = other.size_;
    other.reset();
  }
  void link_before(NodeBase* pos, NodeBase* n) {
    n->prev = pos->prev;
    n->next = pos;
    pos->prev->next = n;
    pos->prev = n;
    ++size_;
  }
  void link_back(Node* n) { link_before(&sentinel_, n); }
  void unlink(NodeBase* n) {
    n->prev->next = n->next;
    n->next->prev = n->prev;
    --size_;
  }

public:
  using value_type = T;
  using allocator_type = Allocator;
  using size_type = size_t;
  using difference_type = ptrdiff_t;
  using reference = T&;
  using const_reference = const T&;
  using pointer = T*;
  using const_pointer = const T*;

  struct iterator {
    using iterator_category = bidirectional_iterator_tag;
    using value_type = T;
    using difference_type = ptrdiff_t;
    using pointer = T*;
    using reference = T&;
    NodeBase* n;
    explicit iterator(NodeBase* n = nullptr) : n(n) {}
    T& operator*() const { return node(n)->value; }
    T* operator->() const { return &node(n)->value; }
    iterator& operator++() {
      n = n->next;
      return *this;
    }
    iterator operator++(int) {
      auto t = *this;
      ++*this;
      return t;
    }
    iterator& operator--() {
      n = n->prev;
      return *this;
    }
    bool operator==(const iterator& o) const { return n == o.n; }
    bool operator!=(const iterator& o) const { return n != o.n; }
  };
  struct const_iterator {
    using iterator_category = bidirectional_iterator_tag;
    using value_type = T;
    using difference_type = ptrdiff_t;
    using pointer = const T*;
    using reference = const T&;
    const NodeBase* n;
    explicit const_iterator(const NodeBase* n = nullptr) : n(n) {}
    const_iterator(iterator it) : n(it.n) {}
    const T& operator*() const { return node(n)->value; }
    const T* operator->() const { return &node(n)->value; }
    const_iterator& operator++() {
      n = n->next;
      return *this;
    }
    const_iterator operator++(int) {
      auto t = *this;
      ++*this;
      return t;
    }
    const_iterator& operator--() {
      n = n->prev;
      return *this;
    }
    const_iterator operator--(int) {
      auto t = *this;
      --*this;
      return t;
    }
    bool operator==(const const_iterator& o) const { return n == o.n; }
    bool operator!=(const const_iterator& o) const { return n != o.n; }
    friend bool operator==(iterator a, const_iterator b) { return a.n == b.n; }
    friend bool operator==(const_iterator a, iterator b) { return a.n == b.n; }
    friend bool operator!=(iterator a, const_iterator b) { return !(a == b); }
    friend bool operator!=(const_iterator a, iterator b) { return !(a == b); }
  };

  using reverse_iterator = std::reverse_iterator<iterator>;
  using const_reverse_iterator = std::reverse_iterator<const_iterator>;

  list() = default;
  explicit list(const Allocator& alloc) : alloc_(alloc) {}
  list(initializer_list<T> il) {
    for (const auto& v : il)
      push_back(v);
  }
  list(size_type n, const T& val = T{}) {
    for (size_type i = 0; i < n; ++i)
      push_back(val);
  }
  template <typename It> list(It first, It last) {
    for (; first != last; ++first)
      push_back(*first);
  }
  list(const list& o) : alloc_(o.alloc_) {
    for (const auto& v : o)
      push_back(v);
  }
  list(list&& o) noexcept : alloc_(o.alloc_) { take_nodes(o); }
  ~list() { clear(); }
  list& operator=(const list& o) {
    if (this != &o) {
      clear();
      alloc_ = o.alloc_;
      for (const auto& v : o)
        push_back(v);
    }
    return *this;
  }
  list& operator=(list&& o) noexcept {
    if (this != &o) {
      clear();
      alloc_ = o.alloc_;
      take_nodes(o);
    }
    return *this;
  }

  iterator begin() { return iterator(sentinel_.next); }
  iterator end() { return iterator(&sentinel_); }
  const_iterator begin() const { return const_iterator(sentinel_.next); }
  const_iterator end() const { return const_iterator(&sentinel_); }
  const_iterator cbegin() const { return begin(); }
  const_iterator cend() const { return end(); }

  reverse_iterator rbegin() { return reverse_iterator(end()); }
  reverse_iterator rend() { return reverse_iterator(begin()); }
  const_reverse_iterator rbegin() const {
    return const_reverse_iterator(end());
  }
  const_reverse_iterator rend() const {
    return const_reverse_iterator(begin());
  }
  const_reverse_iterator crbegin() const { return rbegin(); }
  const_reverse_iterator crend() const { return rend(); }

  size_type size() const noexcept { return size_; }
  bool empty() const noexcept { return size_ == 0; }
  allocator_type get_allocator() const noexcept { return alloc_; }

  T& front() { return node(sentinel_.next)->value; }
  const T& front() const { return node(sentinel_.next)->value; }
  T& back() { return node(sentinel_.prev)->value; }
  const T& back() const { return node(sentinel_.prev)->value; }

  void push_back(const T& v) { link_back(new Node(v)); }
  void push_back(T&& v) { link_back(new Node(static_cast<T&&>(v))); }
  void push_front(const T& v) {
    Node* n = new Node(v);
    link_before(sentinel_.next, n);
  }
  void pop_back() {
    Node* n = node(sentinel_.prev);
    unlink(n);
    delete n;
  }
  void pop_front() {
    Node* n = node(sentinel_.next);
    unlink(n);
    delete n;
  }
  void resize(size_type count) {
    while (size_ > count)
      pop_back();
    while (size_ < count)
      emplace_back();
  }
  void resize(size_type count, const value_type& value) {
    while (size_ > count)
      pop_back();
    while (size_ < count)
      push_back(value);
  }
  template <typename... Args> iterator emplace_back(Args&&... args) {
    Node* n = new Node(static_cast<Args&&>(args)...);
    link_back(n);
    return iterator(n);
  }
  template <typename... Args> iterator emplace_front(Args&&... args) {
    Node* n = new Node(static_cast<Args&&>(args)...);
    link_before(sentinel_.next, n);
    return iterator(n);
  }
  template <typename... Args>
  iterator emplace(const_iterator pos, Args&&... args) {
    Node* n = new Node(static_cast<Args&&>(args)...);
    link_before(const_cast<NodeBase*>(pos.n), n);
    return iterator(n);
  }
  void clear() {
    NodeBase* n = sentinel_.next;
    while (n != &sentinel_) {
      NodeBase* next = n->next;
      delete node(n);
      n = next;
    }
    reset();
  }
  iterator erase(iterator it) {
    NodeBase* n = it.n;
    NodeBase* next = n->next;
    unlink(n);
    delete node(n);
    return iterator(next);
  }
  iterator erase(const_iterator it) {
    NodeBase* n = const_cast<NodeBase*>(it.n);
    NodeBase* next = n->next;
    unlink(n);
    delete node(n);
    return iterator(next);
  }
  iterator erase(const_iterator first, const_iterator last) {
    while (first != last)
      first = erase(first);
    return iterator(const_cast<NodeBase*>(last.n));
  }
  iterator insert(const_iterator pos, const T& v) {
    return insert(iterator(const_cast<NodeBase*>(pos.n)), v);
  }
  iterator insert(iterator pos, const T& v) {
    Node* n = new Node(v);
    link_before(pos.n, n);
    return iterator(n);
  }
  template <typename It>
  iterator insert(const_iterator pos, It first, It last) {
    NodeBase* cur = const_cast<NodeBase*>(pos.n);
    for (; first != last; ++first) {
      Node* n = new Node(*first);
      link_before(cur, n);
    }
    return iterator(pos.n == &sentinel_ ? sentinel_.prev : cur);
  }
  void sort() {
    sort([](const T& a, const T& b) { return a < b; });
  }
  template <typename Compare> void sort(Compare comp) {
    if (size_ <= 1)
      return;
    for (size_type width = 1; width < size_; width *= 2) {
      NodeBase* left = sentinel_.next;
      while (left != &sentinel_) {
        NodeBase* right = left;
        size_type left_count = 0;
        while (left_count < width && right != &sentinel_) {
          right = right->next;
          ++left_count;
        }
        if (right == &sentinel_)
          break;

        NodeBase* after = right;
        size_type right_count = 0;
        while (right_count < width && after != &sentinel_) {
          after = after->next;
          ++right_count;
        }

        NodeBase* a = left;
        NodeBase* b = right;
        while (left_count && right_count) {
          if (!comp(node(b)->value, node(a)->value)) {
            a = a->next;
            --left_count;
            continue;
          }

          NodeBase* next = b->next;
          b->prev->next = next;
          next->prev = b->prev;
          b->prev = a->prev;
          b->next = a;
          a->prev->next = b;
          a->prev = b;
          b = next;
          --right_count;
        }
        left = after;
      }
      if (width > size_ / 2)
        break;
    }
  }
  void remove(const T& val) {
    NodeBase* n = sentinel_.next;
    while (n != &sentinel_) {
      NodeBase* next = n->next;
      if (node(n)->value == val) {
        unlink(n);
        delete node(n);
      }
      n = next;
    }
  }
  template <typename Pred> size_type remove_if(Pred pred) {
    size_type removed = 0;
    NodeBase* n = sentinel_.next;
    while (n != &sentinel_) {
      NodeBase* next = n->next;
      if (pred(node(n)->value)) {
        unlink(n);
        delete node(n);
        ++removed;
      }
      n = next;
    }
    return removed;
  }
  void unique() {
    NodeBase* n = sentinel_.next;
    while (n->next != &sentinel_) {
      if (node(n)->value == node(n->next)->value) {
        NodeBase* dup = n->next;
        unlink(dup);
        delete node(dup);
      } else {
        n = n->next;
      }
    }
  }
  void splice(const_iterator pos, list& other) {
    if (this == &other || other.empty())
      return;
    NodeBase* at = const_cast<NodeBase*>(pos.n);
    NodeBase* first = other.sentinel_.next;
    NodeBase* last = other.sentinel_.prev;
    size_type count = other.size_;
    other.reset();
    first->prev = at->prev;
    at->prev->next = first;
    last->next = at;
    at->prev = last;
    size_ += count;
  }
  void splice(const_iterator pos, list& other, const_iterator it) {
    if (it == other.end())
      return;
    const_iterator next_it(it.n->next);
    if (this == &other && (pos == it || pos == next_it))
      return;
    splice(pos, other, it, next_it);
  }
  void splice(const_iterator pos, list& other, const_iterator first,
              const_iterator last) {
    if (first == last)
      return;
    NodeBase* f = const_cast<NodeBase*>(first.n);
    NodeBase* l = const_cast<NodeBase*>(last.n);
    // Detach range [f, l) from other
    NodeBase* prev = f->prev;
    NodeBase* before_last = l->prev;
    prev->next = l;
    l->prev = prev;
    // Count and adjust other size
    size_t n = 0;
    for (NodeBase* cur = f; cur != l; cur = cur->next)
      ++n;
    if (n > other.size_)
      n = other.size_;
    other.size_ -= n;
    // Insert into this list before pos
    NodeBase* at = const_cast<NodeBase*>(pos.n);
    at->prev->next = f;
    f->prev = at->prev;
    before_last->next = at;
    at->prev = before_last;
    size_ += n;
  }
};

template <typename T, typename A>
bool operator==(const list<T, A>& a, const list<T, A>& b) {
  if (a.size() != b.size())
    return false;
  auto ai = a.begin(), bi = b.begin();
  for (; ai != a.end(); ++ai, ++bi)
    if (!(*ai == *bi))
      return false;
  return true;
}
template <typename T, typename A>
bool operator!=(const list<T, A>& a, const list<T, A>& b) {
  return !(a == b);
}
template <typename T, typename A>
bool operator<(const list<T, A>& a, const list<T, A>& b) {
  return __lexicographical_compare(a.begin(), a.end(), b.begin(), b.end());
}

} // namespace std
