#pragma once
#include <__psychicstd_type_traits_classification>

namespace std {
// invoke_result / result_of (deprecated in C++17, removed in C++20 but Catch2
// uses it)
namespace detail {
template <typename T> struct invoke_is_pointer : false_type {};
template <typename T> struct invoke_is_pointer<T*> : true_type {};
template <typename T> struct invoke_is_pointer<T* const> : true_type {};
template <typename T> struct invoke_is_pointer<T* volatile> : true_type {};
template <typename T>
struct invoke_is_pointer<T* const volatile> : true_type {};

template <typename F, typename... Args>
auto invoke_expr(F&& f, Args&&... args) noexcept(
    noexcept(declval<F>()(declval<Args>()...)))
    -> decltype(declval<F>()(declval<Args>()...));
template <typename R, typename C, typename Obj, typename... Args>
auto invoke_expr(R C::* member, Obj* obj, Args&&... args) noexcept(
    noexcept((obj->*member)(declval<Args>()...)))
    -> decltype((obj->*member)(declval<Args>()...));
template <typename R, typename C, typename Obj, typename... Args>
auto invoke_expr(R C::* member, Obj&& obj, Args&&... args) noexcept(
    noexcept((declval<Obj>().*member)(declval<Args>()...)))
    -> decltype((declval<Obj>().*member)(declval<Args>()...));
template <typename R, typename C, typename Obj>
auto invoke_expr(R C::* member, Obj* obj) noexcept(noexcept(obj->*member))
    -> decltype(obj->*member);
template <typename R, typename C, typename Obj>
auto invoke_expr(R C::* member,
                 Obj&& obj) noexcept(noexcept(declval<Obj>().*member))
    -> decltype(declval<Obj>().*member);

template <typename Void, typename F, typename... Args>
struct invoke_result_impl {};
template <typename F, typename... Args>
struct invoke_result_impl<void_t<decltype(declval<F>()(declval<Args>()...))>, F,
                          Args...> {
  using type = decltype(declval<F>()(declval<Args>()...));
};
template <typename R, typename C, typename Obj, typename... Args>
struct invoke_result_impl<
    void_t<decltype((declval<Obj>().*declval<R C::*>())(declval<Args>()...))>,
    R C::*, Obj, Args...> {
  using type =
      decltype((declval<Obj>().*declval<R C::*>())(declval<Args>()...));
};
template <typename R, typename C, typename Obj, typename... Args>
struct invoke_result_impl<
    void_t<decltype((declval<Obj*>()->*declval<R C::*>())(declval<Args>()...))>,
    R C::*, Obj*, Args...> {
  using type =
      decltype((declval<Obj*>()->*declval<R C::*>())(declval<Args>()...));
};
template <typename R, typename C, typename Obj, typename... Args>
  requires(!__is_base_of(C, remove_cvref_t<Obj>) &&
           !invoke_is_pointer<remove_reference_t<Obj>>::value)
struct invoke_result_impl<
    void_t<decltype(((*declval<Obj>()).*
                     declval<R C::*>())(declval<Args>()...))>,
    R C::*, Obj, Args...> {
  using type =
      decltype(((*declval<Obj>()).*declval<R C::*>())(declval<Args>()...));
};
template <typename R, typename C, typename Obj>
struct invoke_result_impl<void_t<decltype(declval<Obj>().*declval<R C::*>())>,
                          R C::*, Obj> {
  using type = decltype(declval<Obj>().*declval<R C::*>());
};
template <typename R, typename C, typename Obj>
struct invoke_result_impl<void_t<decltype(declval<Obj*>()->*declval<R C::*>())>,
                          R C::*, Obj*> {
  using type = decltype(declval<Obj*>()->*declval<R C::*>());
};
template <typename R, typename C, typename Obj>
  requires(!__is_base_of(C, remove_cvref_t<Obj>) &&
           !invoke_is_pointer<remove_reference_t<Obj>>::value)
struct invoke_result_impl<
    void_t<decltype((*declval<Obj>()).*declval<R C::*>())>, R C::*, Obj> {
  using type = decltype((*declval<Obj>()).*declval<R C::*>());
};
template <typename Void, typename R, typename C, typename Obj, typename... Args>
struct invoke_result_impl<Void, R C::*, Obj*&, Args...>
    : invoke_result_impl<Void, R C::*, Obj*, Args...> {};
template <typename Void, typename R, typename C, typename Obj, typename... Args>
struct invoke_result_impl<Void, R C::*, Obj* const&, Args...>
    : invoke_result_impl<Void, R C::*, Obj*, Args...> {};
template <typename Void, typename R, typename C, typename Obj, typename... Args>
struct invoke_result_impl<Void, R C::*, Obj*&&, Args...>
    : invoke_result_impl<Void, R C::*, Obj*, Args...> {};
template <typename Void, typename R, typename C, typename Obj, typename... Args>
struct invoke_result_impl<Void, R C::*, Obj* const&&, Args...>
    : invoke_result_impl<Void, R C::*, Obj*, Args...> {};

// Preserve a function object's cv/ref qualification, while normalizing member
// pointer wrappers so they reach the specializations above.
template <typename F, typename = remove_cvref_t<F>> struct invoke_callable {
  using type = F;
};
template <typename F, typename R, typename C>
struct invoke_callable<F, R C::*> {
  using type = R C::*;
};
}
template <typename F, typename... Args>
struct invoke_result
    : detail::invoke_result_impl<
          void, typename detail::invoke_callable<F>::type, Args...> {};
template <typename F, typename... Args>
using invoke_result_t = typename invoke_result<F, Args...>::type;

// result_of<F(Args...)> — legacy alias; SFINAE-friendly: has ::type only when
// callable
template <typename> struct result_of;
template <typename F, typename... Args>
struct result_of<F(Args...)> : invoke_result<F, Args...> {};
template <typename T> using result_of_t = typename result_of<T>::type;

// is_invocable
namespace detail {
template <typename Void, typename F, typename... Args>
struct is_invocable_impl : false_type {};
template <typename F, typename... Args>
struct is_invocable_impl<void_t<typename invoke_result<F, Args...>::type>, F,
                         Args...> : true_type {};
}
template <typename F, typename... Args>
struct is_invocable : detail::is_invocable_impl<void, F, Args...> {};
template <typename F, typename... Args>
inline constexpr bool is_invocable_v = is_invocable<F, Args...>::value;

}
