#pragma once
#include <__psychicstd_iterator_core>
#include <__psychicstd_type_traits_arithmetic>
#include <__psychicstd_type_traits_meta>
#include <concepts>

namespace std {
template <typename T> class initializer_list;
}

namespace std::ranges {

// -- CPOs: begin / end -------------------------------------------------------
namespace __detail {
struct __begin_fn {
  template <typename R> constexpr auto operator()(R&& r) const {
    return r.begin();
  }
  template <typename T, size_t N>
  constexpr T* operator()(T (&a)[N]) const noexcept {
    return a;
  }
};
struct __end_fn {
  template <typename R> constexpr auto operator()(R&& r) const {
    return r.end();
  }
  template <typename T, size_t N>
  constexpr T* operator()(T (&a)[N]) const noexcept {
    return a + N;
  }
};
struct __size_fn {
  template <typename R> constexpr auto operator()(R&& r) const {
    return r.size();
  }
};
// Poison pill to prevent recursive ADL in __iter_move_fn
void iter_move() = delete;
void iter_swap() = delete;

template <typename I>
concept __has_adl_iter_move =
    // forward
    requires(I&& i) { iter_move(static_cast<I&&>(i)); };

template <typename I>
concept __has_adl_iter_swap = requires(I&& a, I&& b) {
  // forward
  iter_swap(static_cast<I&&>(a), static_cast<I&&>(b));
};

struct __iter_move_fn {
  template <typename I> constexpr auto operator()(I&& i) const {
    if constexpr (__has_adl_iter_move<I&&>) {
      // forward
      return iter_move(static_cast<I&&>(i));
    } else {
      // move
      return static_cast<std::remove_reference_t<decltype(*i)>&&>(*i);
    }
  }
};
struct __iter_swap_fn {
  template <typename I1, typename I2>
  constexpr void operator()(I1&& a, I2&& b) const {
    if constexpr (__has_adl_iter_swap<I1&&>) {
      // forward
      iter_swap(static_cast<I1&&>(a), static_cast<I2&&>(b));
    } else {
      // move
      auto tmp = static_cast<std::remove_reference_t<decltype(*a)>&&>(*a);
      // move
      *a = static_cast<std::remove_reference_t<decltype(*b)>&&>(*b);
      // move
      *b = static_cast<decltype(tmp)&&>(tmp);
    }
  }
};
} // namespace __detail

inline constexpr __detail::__begin_fn begin{};
inline constexpr __detail::__end_fn end{};
inline constexpr __detail::__size_fn size{};
inline constexpr __detail::__iter_move_fn iter_move{};
inline constexpr __detail::__iter_swap_fn iter_swap{};

// -- Concepts ----------------------------------------------------------------
template <typename T>
concept range = requires(T& t) {
  std::ranges::begin(t);
  std::ranges::end(t);
};

template <typename T>
concept borrowed_range = range<T>;

template <typename T>
concept sized_range = range<T> && requires(T& t) { std::ranges::size(t); };

template <typename T>
concept input_range = range<T>;

template <typename T>
concept forward_range = range<T>;

template <typename T>
concept bidirectional_range = range<T>;

template <typename T>
concept random_access_range = range<T>;

template <typename T>
concept contiguous_range = range<T>;

template <typename T>
concept common_range = range<T>;

template <typename T>
concept output_range = range<T>;

// view: a range that is semiregular
template <typename T>
concept view = range<T> && std::movable<T>;

namespace __detail {
template <typename T> inline constexpr bool __is_initializer_list = false;
template <typename T>
inline constexpr bool __is_initializer_list<std::initializer_list<T>> = true;
} // namespace __detail

template <typename R>
concept viewable_range =
    range<R> && (std::is_lvalue_reference_v<R> ||
                 (std::movable<std::remove_reference_t<R>> &&
                  !__detail::__is_initializer_list<std::remove_cvref_t<R>>));

// range_value_t etc.
template <typename R>
using iterator_t = decltype(std::ranges::begin(std::declval<R&>()));

template <typename R>
using sentinel_t = decltype(std::ranges::end(std::declval<R&>()));

template <typename I>
using iter_value_t = typename std::iterator_traits<I>::value_type;

template <typename I>
using iter_reference_t = typename std::iterator_traits<I>::reference;

template <typename R> using range_value_t = iter_value_t<iterator_t<R>>;

template <typename R> using range_reference_t = iter_reference_t<iterator_t<R>>;

// enable_view
template <typename T> inline constexpr bool enable_view = false;

// view_base
struct view_base {};

template <typename Iterator, typename Sentinel = Iterator> class subrange {
public:
  constexpr subrange() = default;
  constexpr subrange(Iterator first, Sentinel last)
      : first_(static_cast<Iterator&&>(first)),
        last_(static_cast<Sentinel&&>(last)) {}

  // Without borrowed_range support, only accept ranges that outlive this view.
  template <typename Range>
    requires(!std::is_same_v<std::remove_cvref_t<Range>, subrange> &&
             std::is_lvalue_reference_v<Range>)
  constexpr subrange(Range&& range)
      : first_(std::ranges::begin(range)), last_(std::ranges::end(range)) {}

  constexpr Iterator begin() const { return first_; }
  constexpr Sentinel end() const { return last_; }

private:
  Iterator first_{};
  Sentinel last_{};
};

template <typename Iterator, typename Sentinel>
subrange(Iterator, Sentinel) -> subrange<Iterator, Sentinel>;
template <typename Range>
  requires std::is_lvalue_reference_v<Range>
subrange(Range&&) -> subrange<iterator_t<Range>, sentinel_t<Range>>;

template <typename Range, typename Function> class transform_view {
  template <typename Iterator> class __iterator {
  public:
    Iterator current_{};
    Function* function_ = nullptr;

    constexpr decltype(auto) operator*() const {
      return (*function_)(*current_);
    }
    constexpr __iterator& operator++() {
      ++current_;
      return *this;
    }
    constexpr void operator++(int) { ++current_; }
    template <typename Other>
    constexpr bool operator==(const __iterator<Other>& other) const {
      return current_ == other.current_;
    }
    template <typename Other>
    constexpr bool operator!=(const __iterator<Other>& other) const {
      return !(*this == other);
    }
  };

public:
  constexpr transform_view(Range range, Function function)
      : range_(static_cast<Range&&>(range)),
        function_(static_cast<Function&&>(function)) {}

  constexpr auto begin() {
    return __iterator<decltype(std::ranges::begin(range_))>{
        std::ranges::begin(range_), &function_};
  }
  constexpr auto end() {
    return __iterator<decltype(std::ranges::end(range_))>{
        std::ranges::end(range_), &function_};
  }

private:
  Range range_;
  Function function_;
};

} // namespace std::ranges

namespace std::views {

template <typename R>
using all_t = std::conditional_t<std::is_lvalue_reference_v<R>, R,
                                 std::remove_cvref_t<R>>;

struct __all_fn {
  template <typename R>
    requires std::ranges::viewable_range<R>
  constexpr auto operator()(R&& r) const noexcept -> R&& {
    // forward
    return static_cast<R&&>(r);
  }
};
inline constexpr __all_fn all{};

template <typename Function> class __transform_closure {
public:
  constexpr explicit __transform_closure(Function function)
      : function_(static_cast<Function&&>(function)) {}

  template <typename Range>
    requires std::ranges::viewable_range<Range>
  friend constexpr auto operator|(Range&& range,
                                  const __transform_closure& closure) {
    using View = all_t<Range>;
    return std::ranges::transform_view<View, Function>(
        all(static_cast<Range&&>(range)), closure.function_);
  }

private:
  Function function_;
};

struct __transform_fn {
  template <typename Function>
  constexpr auto operator()(Function&& function) const {
    using F = std::decay_t<Function>;
    return __transform_closure<F>(static_cast<Function&&>(function));
  }
  template <typename Range, typename Function>
    requires std::ranges::viewable_range<Range>
  constexpr auto operator()(Range&& range, Function&& function) const {
    using View = all_t<Range>;
    using F = std::decay_t<Function>;
    return std::ranges::transform_view<View, F>(
        all(static_cast<Range&&>(range)), static_cast<Function&&>(function));
  }
};
inline constexpr __transform_fn transform{};

} // namespace std::views
