namespace std {
template <typename T> struct is_volatile : false_type {};
template <typename T> struct is_volatile<volatile T> : true_type {};
template <typename T>
inline constexpr bool is_volatile_v = is_volatile<T>::value;

template <typename B, typename D>
struct is_base_of : bool_constant<__is_base_of(B, D)> {};
template <typename B, typename D>
inline constexpr bool is_base_of_v = is_base_of<B, D>::value;

// is_null_pointer / is_integral / is_floating_point / is_pointer
template <typename T>
struct is_null_pointer : is_same<remove_cv_t<T>, nullptr_t> {};

}
